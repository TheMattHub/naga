  "agent_types": [
    {
      "name": "Schelling Person",
      "parameters": {"tol": 0.4},
      "attributes": [{"name": "like_frac", "init": "0.5"}],
      "states": [{"name": "Red"}, {"name": "Blue"}],
      "transitions": [
        {
          "from": "Red",
          "to": "Red",
          "tick": "self.like_frac < tol",
          "actions": [{"move_random": "free"}]
        },
        {
          "from": "Blue",
          "to": "Blue",
          "tick": "self.like_frac < tol",
          "actions": [{"move_random": "free"}]
        }
      ],
      "initial_state": "Blue",
      "space": {"kind": "grid", "size": [20, 20], "torus": true, "neighbourhood": "moore"},
      "tick": {"dt": 1, "activation": "random", "time_unit": "minutes"},
      "on_tick": [
        {
          "target": "self.like_frac",
          "expr": "IF(NEIGHBOURS(\"$Schelling People\") > 0, IF(self.state == \"Red\", NEIGHBOURS(\"$Schelling People\", \"Red\"), NEIGHBOURS(\"$Schelling People\", \"Blue\")) / NEIGHBOURS(\"$Schelling People\"), 1)"
        }
      ]
    }
  ],
