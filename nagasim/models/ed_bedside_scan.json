      "position": [2400.0, 560.0],
      "params": {"distribution": "Triangular", "dist_params": {"low": 20, "mode": 30, "high": 45}}
    },
    {
      "name": "Decision",
      "type": "RECORD",
      "description": "The doctor decides: home or admitted. Records the time from arrival",
      "position": [2600.0, 700.0],
      "params": {
        "stat_name": "arrival_to_decision",
        "kind": "tally",
        "expr": "TNOW - entity.creation_time"
      }
    },
    {
      "name": "Count decisions",
      "type": "ASSIGN",
      "description": "Updates the dashboard's counters",
      "position": [2800.0, 700.0],
      "params": {
        "assignments": [
          {"target": "decisions", "expr": "decisions + 1"},
          {"target": "decision_sum", "expr": "decision_sum + TNOW - entity.creation_time"},
          {"target": "ct_scans", "expr": "ct_scans + entity.ct"},
          {"target": "entity.sequence", "expr": "\"leave\""},
          {"target": "entity.step", "expr": "0"}
        ]
      }
    },
    {
      "name": "Walk out",
