  "schema_version": 29,
  "blocks": [
    {
      "name": "Arrivals",
      "type": "CREATE",
      "description": "Walk-in patients, one every 18 minutes on average (invented)",
      "position": [0.0, 0.0],
      "params": {
        "e_type": "PATIENT",
        "distribution": "Exponential",
        "dist_params": {"rate": 0.05555555555555555}
      }
    },
    {
      "name": "Patient details",
      "type": "ASSIGN",
      "description": "Each patient's own times and risk, drawn once at arrival so both pathways treat the same patient the same way (common random numbers)",
      "position": [200.0, 0.0],
      "params": {
        "assignments": [
          {"target": "entity.walk", "expr": "55"},
          {"target": "entity.visit_min", "expr": "TRIA(8, 12, 20)"},
          {"target": "entity.scan_min", "expr": "TRIA(6, 9, 14)"},
          {"target": "entity.lab_min", "expr": "TRIA(45, 60, 95)"},
          {"target": "entity.risk", "expr": "RAND()"},
          {"target": "entity.ct", "expr": "0"},
          {"target": "entity.sequence", "expr": "\"arrive\""},
          {"target": "entity.step", "expr": "0"},
          {"target": "in_ed", "expr": "in_ed + 1"}
        ]
      }
    },
    {
      "name": "Walk in",
      "type": "ROUTE",
      "description": "Appears at the entrance",
