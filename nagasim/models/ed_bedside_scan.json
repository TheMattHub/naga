  "info": {
    "title": "Emergency department: bedside scan (film template)",
    "category": "Services",
    "description": "A teaching model for the Film dock: walk-in patients in a small emergency department on a 32 x 17 m floor plan go through triage, wait for one of five exam bays, see a doctor and leave with a decision. Two scenarios run with common random numbers: the usual pathway waits for blood tests before deciding, the other scans at the bed first. Every number is invented for teaching; none comes from a real hospital.",
    "author": "Naga",
    "notes": "Times in minutes, distances in metres, walking 55 m/min. Each patient's visit, scan and blood-test times and risk are drawn once at arrival, so the same patient meets both pathways (see the Film a run tutorial)."
  },
  "simulation": {
    "time_limit": 720,
    "warmup": 0,
    "replications": 5,
    "calendar": {"start": "2026-01-05T08:00:00"}
  },
  "outputs": {},
  "dashboard": {
    "widgets": [
      {"name": "Patients in the ED", "kind": "kpi", "title": "Patients in the ED", "expr": "in_ed"},
      {
        "name": "Mean time to decision",
        "kind": "kpi",
        "title": "Arrival to decision, mean (min)",
        "expr": "round(ZIDZ(decision_sum, decisions))"
      },
      {"name": "CT scans", "kind": "kpi", "title": "CT scans", "expr": "ct_scans"}
    ]
  }
