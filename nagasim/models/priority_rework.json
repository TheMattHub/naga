        "start_time": 0,
        "time_unit": "minutes",
        "start_time_unit": "minutes"
      }
    },
    {
      "name": "assign_1",
      "description": "Draw a priority, start with no rework",
      "type": "ASSIGN",
      "position": [
        380.0,
        320.0
      ],
      "params": {
        "assignments": [
          {
            "target": "entity.priority",
            "expr": "DISC(1, 0.3, 2, 0.7)"
          },
          {
            "target": "entity.rework",
            "expr": "0"
          }
        ]
      }
    },
    {
      "name": "seize_1",
      "description": "Serve",
      "type": "SEIZE",
      "position": [
        600.0,
        320.0
