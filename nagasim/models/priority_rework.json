        "dist_params": {
          "rate": 1.25
        },
        "priority": 0,
        "quantity": 1,
        "resource_name": "Server",
        "time_unit": "minutes",
        "renege_time_unit": "minutes"
      }
    },
    {
      "name": "release_1",
      "description": "release_1",
      "type": "RELEASE",
      "position": [
        800.0,
        320.0
      ],
      "params": {
        "distribution": "Constant",
        "dist_params": {
          "value": 0.0
        },
        "resource_name": "Server",
        "time_unit": "minutes"
      }
    },
    {
      "name": "decide_1",
      "description": "Rework at most twice, 20% of the time",
      "type": "DECIDE",
      "position": [
        1000.0,
        320.0
      ],
      "params": {
        "mode": "Condition",
        "probs": [],
        "conditions": [
          "entity.rework < 2 and RAND() < 0.2"
        ]
      }
    },
    {
      "name": "assign_rework",
      "description": "Count the rework, on the entity and model-wide",
      "type": "ASSIGN",
      "position": [
        1000.0,
        160.0
      ],
      "params": {
        "assignments": [
          {
            "target": "entity.rework",
            "expr": "entity.rework + 1"
          },
          {
            "target": "rework_count",
            "expr": "rework_count + 1"
          }
        ]
      }
    },
    {
      "name": "record_rework_count",
      "description": "RECORD (ROADMAP 1.3): tally each rework event as a user statistic",
      "type": "RECORD",
      "position": [
        850.0,
        160.0
      ],
      "params": {
        "stat_name": "rework_events",
        "kind": "count",
        "expr": "1"
      }
    },
    {
      "name": "delay_rework",
      "description": "Rework takes a fixed extra minute",
      "type": "DELAY",
      "position": [
        700.0,
        160.0
      ],
      "params": {
        "distribution": "Constant",
        "dist_params": {
          "value": 1.0
        },
        "time_unit": "minutes"
      }
    },
    {
      "name": "decide_reworked",
      "description": "Split off entities that were reworked at least once",
      "type": "DECIDE",
      "position": [
        1150.0,
        320.0
      ],
      "params": {
        "mode": "Condition",
        "probs": [],
        "conditions": [
          "entity.rework > 0"
        ]
      }
    },
    {
      "name": "record_rework_time",
      "description": "RECORD (ROADMAP 1.3): tally time in system for reworked entities",
      "type": "RECORD",
      "position": [
        1150.0,
        460.0
      ],
      "params": {
        "stat_name": "time_in_system_reworked",
        "kind": "tally",
        "expr": "TNOW - entity.creation_time"
      }
    },
    {
      "name": "dispose_1",
