{
  "$schema": "https://thematthub.github.io/naga/schema/model-v29.json",
  "schema_version": 29,
  "blocks": [
    {
      "name": "create_1",
      "type": "CREATE",
      "description": "Jobs arrive",
      "position": [
        160.0,
        320.0
      ],
      "params": {
        "distribution": "Exponential",
        "dist_params": {
          "rate": 1.0
        }
      }
    },
    {
      "name": "assign_1",
      "type": "ASSIGN",
      "description": "Draw a priority, start with no rework",
      "position": [
        380.0,
        320.0
      ],
      "params": {
        "assignments": [
          {
            "target": "entity.priority",
            "expr": "DISC(1, 0.3, 2, 0.7)"
          },
          {
            "target": "entity.rework",
            "expr": "0"
          }
        ]
      }
    },
    {
      "name": "seize_1",
      "type": "SEIZE",
      "description": "Serve",
      "position": [
        600.0,
        320.0
      ],
      "params": {
        "distribution": "Exponential",
        "dist_params": {
          "rate": 1.25
        },
        "resource_name": "Server"
      }
    },
    {
      "name": "release_1",
      "type": "RELEASE",
      "position": [
        800.0,
        320.0
      ],
      "params": {
        "resource_name": "Server"
      }
    },
    {
      "name": "decide_1",
      "type": "DECIDE",
      "description": "Rework at most twice, 20% of the time",
      "position": [
        1000.0,
        320.0
      ],
      "params": {
        "mode": "Condition",
        "conditions": [
          "entity.rework < 2 and RAND() < 0.2"
        ]
      }
    },
    {
      "name": "assign_rework",
      "type": "ASSIGN",
      "description": "Count the rework, on the entity and model-wide",
      "position": [
        1000.0,
        160.0
      ],
      "params": {
        "assignments": [
          {
            "target": "entity.rework",
            "expr": "entity.rework + 1"
          },
          {
            "target": "rework_count",
            "expr": "rework_count + 1"
          }
        ]
      }
    },
    {
      "name": "record_rework_count",
      "type": "RECORD",
      "description": "RECORD (ROADMAP 1.3): tally each rework event as a user statistic",
      "position": [
        850.0,
        160.0
      ],
      "params": {
        "stat_name": "rework_events"
      }
    },
    {
      "name": "delay_rework",
      "type": "DELAY",
      "description": "Rework takes a fixed extra minute",
      "position": [
        700.0,
        160.0
      ],
      "params": {
        "dist_params": {
          "value": 1.0
        }
      }
    },
    {
      "name": "decide_reworked",
      "type": "DECIDE",
      "description": "Split off entities that were reworked at least once",
      "position": [
        1150.0,
        320.0
      ],
      "params": {
        "mode": "Condition",
        "conditions": [
          "entity.rework > 0"
        ]
      }
    },
    {
      "name": "record_rework_time",
      "type": "RECORD",
      "description": "RECORD (ROADMAP 1.3): tally time in system for reworked entities",
      "position": [
        1150.0,
        460.0
      ],
      "params": {
        "stat_name": "time_in_system_reworked",
        "kind": "tally",
        "expr": "TNOW - entity.creation_time"
      }
    },
    {
      "name": "dispose_1",
      "type": "DISPOSE",
      "position": [
        1400.0,
        320.0
      ]
    }
  ],
  "links": [
    {
      "source": "create_1",
      "target": "assign_1"
    },
    {
      "source": "assign_1",
      "target": "seize_1"
    },
    {
      "source": "seize_1",
      "target": "release_1"
    },
    {
      "source": "release_1",
      "target": "decide_1"
    },
    {
      "source": "decide_1",
      "target": "assign_rework"
    },
    {
      "source": "decide_1",
      "target": "decide_reworked"
    },
    {
      "source": "assign_rework",
      "target": "record_rework_count"
    },
    {
      "source": "record_rework_count",
      "target": "delay_rework"
    },
    {
      "source": "delay_rework",
      "target": "seize_1"
    },
    {
      "source": "decide_reworked",
      "target": "record_rework_time"
    },
    {
      "source": "decide_reworked",
      "target": "dispose_1"
    },
    {
      "source": "record_rework_time",
      "target": "dispose_1"
    }
  ],
  "resources": [
    {
      "name": "Server",
      "capacity": 1,
      "discipline": "FIFO"
    }
  ],
  "variables": [
    {
      "name": "rework_count",
      "initial": 0
    }
  ],
  "entities": [
    {
      "name": "DEFAULT",
      "shape": "circle",
      "color": "BLACK"
    }
  ],
  "info": {
    "title": "Priority jobs with rework",
    "category": "Manufacturing",
    "description": "Jobs arrive with a random priority and can be sent back for rework up to twice (20% chance each pass); RECORD blocks tally the rework count and the extra time in system it costs."
  },
  "simulation": {
    "time_limit": 300,
    "warmup": 0,
    "replications": 2
  },
  "outputs": {}
}
