      "annotations": [],
      "code": {
        "class": "PhotoEyeRouter",
        "source": "class PhotoEyeRouter:\n    \"\"\"Round robin over three lines; a line with `limit` boxes in flight is skipped, and\n    with every line at the limit the least loaded one takes the box.\"\"\"\n\n    def __init__(self):\n        self.turn = 0\n\n    def on_entry(self, entity, item):\n        ways = [item.params[f\"way_{k}\"] for k in (1, 2, 3)]\n        n = [item.evaluate(f'NR(\"{w}\") + NQ(\"{w}\")') for w in ways]\n        limit = item.params[\"limit\"]\n        order = [(self.turn + k) % 3 for k in range(3)]\n        free = [k for k in order if n[k] < limit]\n        chosen = free[0] if free else min(order, key=lambda k: n[k])\n        self.turn = (chosen + 1) % 3\n        return chosen\n",
        "placed": {
