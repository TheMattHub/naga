  "levels": [
    {
      "name": "Applicants",
      "initial": 60.0,
      "min": 0.0,
      "rate_time_unit": "weeks"
    },
    {
      "name": "Training",
      "initial": 0.0,
      "conveyor": {
        "transit_time": 12,
        "leak_kind": "linear"
      },
      "rate_time_unit": "weeks"
    },
    {
      "name": "Staff",
      "initial": 40.0,
      "min": 0.0,
      "rate_time_unit": "weeks"
    },
    {
      "name": "Dropouts",
      "initial": 0.0,
      "min": 0.0,
      "rate_time_unit": "weeks"
    }
  ],
  "flows": [
    {
      "name": "apply",
      "description": "New applicants join the pool",
      "rate": "AUX(\"arrival_rate\")",
      "to": "Applicants",
      "rate_time_unit": "weeks"
    },
    {
      "name": "hire",
      "description": "Admitted into the training school: capped by the school's own capacity and by the hiring gap",
      "rate": "min(LEVEL(\"Applicants\"), AUX(\"capacity\"), max(0, (AUX(\"staff_goal\") - (LEVEL(\"Staff\") + LEVEL(\"Training\"))) / AUX(\"adj_time\")))",
      "from": "Applicants",
      "to": "Training",
      "rate_time_unit": "weeks"
    },
    {
      "name": "graduate",
      "description": "The conveyor's one primary outflow: whoever reaches the end of training",
      "rate": "",
      "from": "Training",
      "to": "Staff",
      "rate_time_unit": "weeks"
    },
    {
      "name": "dropout",
      "description": "Linear leakage along the belt: trainees who never finish",
      "rate": "",
      "from": "Training",
      "leak": {
        "fraction": "AUX(\"leak_frac\")"
      },
      "rate_time_unit": "weeks"
    },
    {
      "name": "tally_dropouts",
      "description": "An accounting flow reading the leak's own volume, for the dashboard KPI",
      "rate": "FLOW(\"dropout\")",
      "to": "Dropouts",
      "rate_time_unit": "weeks"
    },
    {
      "name": "leave_staff",
      "description": "Staff who leave the floor",
      "rate": "AUX(\"attrition\") * LEVEL(\"Staff\")",
      "from": "Staff",
      "rate_time_unit": "weeks"
    }
  ],
