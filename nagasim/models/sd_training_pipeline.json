  "info": {
    "title": "Training pipeline with attrition",
    "category": "System dynamics",
    "description": "A Stella conveyor as a hiring pipeline: Applicants are admitted into a 12-week Training conveyor, capped by the school's own capacity and by a goal-seeking hiring rule ((staff_goal - in-pipeline headcount) / adj_time); about 15% leak out as dropouts along the way (linear leakage), the rest graduate onto Staff, which loses a small fraction to attrition every week. Needs simulation.sd on method \"euler\" (Stella's slat model moves one slat per DT). In the results, read Staff, Training against Staff over time and cumulative dropouts; \"Hiring target (staff goal)\" can be changed during a run.",
    "author": "Naga example"
  },
  "data_sources": [],
  "data_bindings": [],
  "initial_state": {},
  "simulation": {
    "time_limit": 90.0,
    "warmup": 0.0,
    "replications": 1,
    "time_unit": "weeks",
    "currency": "EUR",
    "energy_price": 0,
    "sd": {
      "dt": 1.0,
      "method": "euler",
      "time_unit": "weeks"
    },
    "length_unit": "meters"
  },
  "outputs": {},
  "dashboard": {
    "widgets": [
      {
        "name": "staff_kpi",
        "kind": "kpi",
        "title": "Staff on the floor",
        "expr": "LEVEL(\"Staff\")"
      },
      {
        "name": "pipeline_line",
        "kind": "line",
        "title": "Training vs. Staff",
        "series": [
          {
            "label": "Training",
            "expr": "LEVEL(\"Training\")"
          },
          {
            "label": "Staff",
            "expr": "LEVEL(\"Staff\")"
          }
        ]
      },
      {
        "name": "dropouts_kpi",
        "kind": "kpi",
        "title": "Cumulative dropouts",
        "expr": "LEVEL(\"Dropouts\")"
      }
    ],
    "controls": [
      {
        "name": "staff_goal_slider",
        "kind": "slider",
        "title": "Hiring target (staff goal)",
        "target": {
          "constant": "staff_goal"
        },
        "min": 40,
        "max": 200,
        "step": 5
      }
    ]
  }
}