          "description": "Charged on the stock on hand, integrated exactly over the stock curve and joined into Total Cost."
        },
        {
          "name": "order_cost",
          "default": 0.0,
          "type": "number",
          "description": "Charged once every time a replenishment order is placed, whatever its size -- paperwork, a truck, a setup at the supplier. It joins Total Cost and is itemised in the cost summary as \"Scm ordering cost\"."
        },
        {
          "name": "lost_sale_penalty",
          "default": 0.0,
          "type": "number",
          "description": "Charged per unit of demand the shelf could not fill (lost sales only: a backordered unit is served late, not lost). It joins Total Cost and is itemised as \"Scm lost sales\"."
        }
      ],
      "scoped": {
        "levels": {
          "Scm Stock": {
            "initial": {
              "$arg": "initial_stock"
            },
            "thresholds.0.value": "reorder_point if review == \"continuous\" else -1e12"
          },
          "Scm On order": {}
        },
        "flows": {
          "Scm holding cost": {
            "price": {
              "$arg": "holding_cost"
            }
          }
        }
      },
      "blocks": [
        {
          "name": "in",
          "description": "Orders arrive",
          "type": "SUB_ENTRY",
          "position": [
            0.0,
            0.0
          ],
          "params": {
            "port": "demand"
          }
        },
        {
          "name": "size",
          "description": "Order size and whether the shelf can fill it",
          "type": "ASSIGN",
          "position": [
            150.0,
            0.0
          ],
          "params": {
            "assignments": [
              {
                "target": "entity.scm_qty",
                "expr": "entity.scm_order if order_from_entity else units_per_order"
              },
              {
                "target": "entity.scm_filled",
                "expr": "1 if LEVEL(\"$Scm Stock\") >= entity.scm_qty else 0"
              }
            ]
          }
        },
        {
          "name": "fill",
          "description": "Fill rate",
          "type": "RECORD",
          "position": [
            300.0,
            0.0
          ],
          "params": {
            "stat_name": "$Scm fill rate",
            "kind": "tally",
            "expr": "entity.scm_filled"
          }
        },
        {
          "name": "check",
          "description": "Serve or lose the sale",
          "type": "DECIDE",
          "position": [
            450.0,
            0.0
          ],
          "params": {
            "mode": "Condition",
            "probs": [],
            "conditions": [
              "1 if allow_backorder else entity.scm_filled"
            ]
          }
        },
        {
          "name": "draw",
          "description": "Take the units off the shelf",
          "type": "TRANSFER",
          "position": [
            600.0,
            -60.0
          ],
          "params": {
            "level": "$Scm Stock",
            "amount": "entity.scm_qty",
            "mode": "remove",
            "wait": {
              "$arg": "allow_backorder"
            }
          }
        },
        {
          "name": "served",
          "description": "Units served",
          "type": "RECORD",
          "position": [
            750.0,
            -60.0
          ],
          "params": {
            "stat_name": "$Scm units served",
            "kind": "count",
            "expr": "entity.scm_qty"
          }
        },
        {
          "name": "out",
          "description": "Served orders leave",
          "type": "SUB_EXIT",
          "position": [
            900.0,
            -60.0
          ],
          "params": {
            "port": "served"
          }
        },
        {
          "name": "lost_units",
          "description": "Units lost",
          "type": "RECORD",
          "position": [
            750.0,
            60.0
          ],
          "params": {
            "stat_name": "$Scm units lost",
            "kind": "count",
            "expr": "entity.scm_qty"
          }
        },
        {
          "name": "lost_charge",
          "description": "Lost-sale penalty",
          "type": "RECORD",
          "position": [
            750.0,
            120.0
          ],
          "params": {
            "stat_name": "$Scm lost sales",
            "kind": "cost",
            "expr": "entity.scm_qty * lost_sale_penalty",
            "category": "Penalty"
          }
        },
        {
          "name": "lost",
          "description": "Lost sales leave",
          "type": "SUB_EXIT",
          "position": [
            900.0,
            60.0
          ],
          "params": {
            "port": "lost"
          }
        },
        {
          "name": "agent",
          "description": "One purchasing agent",
          "type": "CREATE",
          "position": [
            0.0,
            200.0
          ],
          "params": {
            "e_type": "SCM_ORDER",
            "arrival_mode": "Interarrival",
            "distribution": "Constant",
            "dist_params": {
              "value": 1.0
            },
            "time_unit": "days",
            "entities_per_arrival": 1,
            "max_arrivals": 1,
            "start_time": 0,
            "sequence": ""
          }
        },
        {
          "name": "wait_signal",
          "description": "Wait for the stock to reach s",
          "type": "HOLD",
          "position": [
            150.0,
            200.0
          ],
          "params": {
            "mode": "Signal",
            "signal_name": "$Scm reorder",
            "conditions": [],
            "scan_interval": 1.0
          }
        },
        {
          "name": "clock",
          "description": "Periodic review",
          "type": "CREATE",
          "position": [
            0.0,
            320.0
          ],
          "params": {
            "e_type": "SCM_ORDER",
            "arrival_mode": "Interarrival",
            "distribution": "Constant",
            "dist_params": {
              "value": "review_period"
            },
            "time_unit": "days",
            "entities_per_arrival": 1,
            "max_arrivals": 0,
            "start_time": 0,
            "sequence": ""
          }
        },
        {
          "name": "due",
          "description": "Is the position at or below s?",
          "type": "DECIDE",
          "position": [
            150.0,
            320.0
          ],
          "params": {
            "mode": "Condition",
            "probs": [],
            "conditions": [
              "(review == \"periodic\") * (LEVEL(\"$Scm Stock\") + LEVEL(\"$Scm On order\") <= reorder_point)"
            ]
          }
        },
        {
          "name": "place",
          "description": "Order quantity",
          "type": "ASSIGN",
          "position": [
            300.0,
            260.0
          ],
          "params": {
            "assignments": [
              {
                "target": "entity.scm_order",
                "expr": "max(order_up_to - LEVEL(\"$Scm Stock\") - LEVEL(\"$Scm On order\"), 0) if policy == \"sS\" else order_quantity"
              }
            ]
          }
        },
        {
          "name": "orders",
          "description": "Orders placed",
          "type": "RECORD",
          "position": [
            450.0,
            260.0
          ],
          "params": {
            "stat_name": "$Scm orders placed",
            "kind": "count",
            "expr": "1"
          }
        },
        {
          "name": "order_charge",
          "description": "Ordering cost",
          "type": "RECORD",
          "position": [
            525.0,
            200.0
          ],
          "params": {
            "stat_name": "$Scm ordering cost",
            "kind": "cost",
            "expr": "order_cost",
            "category": "Ordering"
          }
        },
        {
          "name": "on_order",
          "description": "Add it to the stock on order",
          "type": "TRANSFER",
          "position": [
            600.0,
            260.0
          ],
          "params": {
            "level": "$Scm On order",
            "amount": "entity.scm_order",
            "mode": "add",
            "wait": false
          }
        },
        {
          "name": "route",
          "description": "Internal lead time or a real supplier",
          "type": "DECIDE",
          "position": [
            750.0,
            260.0
          ],
          "params": {
            "mode": "Condition",
            "probs": [],
            "conditions": [
              "1 if replenishment == \"internal\" else 0"
            ]
          }
        },
        {
          "name": "lead",
          "description": "Supplier lead time",
          "type": "DELAY",
          "position": [
            900.0,
            200.0
          ],
          "params": {
            "distribution": "Constant",
            "dist_params": {
              "value": "lead_time if lead_time_distribution == 'fixed' else (EXPO(lead_time) if lead_time_distribution == 'exponential' else TRIA(0.5 * lead_time, lead_time, 1.5 * lead_time))"
            },
            "time_unit": "days"
          }
        },
        {
          "name": "orders_out",
          "description": "Orders to the supplier",
          "type": "SUB_EXIT",
          "position": [
            900.0,
            320.0
          ],
          "params": {
            "port": "orders"
          }
        },
        {
          "name": "deliveries",
          "description": "Goods arrive",
          "type": "SUB_ENTRY",
          "position": [
            900.0,
            400.0
          ],
          "params": {
            "port": "deliveries"
          }
        },
        {
          "name": "arrive",
          "description": "It is no longer on order",
          "type": "TRANSFER",
          "position": [
            1050.0,
            260.0
          ],
          "params": {
            "level": "$Scm On order",
            "amount": "entity.scm_order",
            "mode": "remove",
            "wait": false
          }
        },
        {
          "name": "receive",
          "description": "Put it on the shelf",
          "type": "TRANSFER",
          "position": [
            1200.0,
            260.0
          ],
          "params": {
            "level": "$Scm Stock",
            "amount": "entity.scm_order",
            "mode": "add",
            "wait": false
          }
        },
        {
          "name": "loop",
          "description": "Back to waiting, or done",
          "type": "DECIDE",
          "position": [
            1350.0,
            260.0
          ],
          "params": {
            "mode": "Condition",
            "probs": [],
            "conditions": [
              "1 if review == \"continuous\" else 0"
            ]
          }
        },
        {
          "name": "skip",
          "description": "No order this period",
          "type": "DISPOSE",
          "position": [
            300.0,
            400.0
          ],
          "params": {
            "distribution": "Constant",
            "dist_params": {
              "value": 0.0
            },
            "time_unit": "base"
          }
        },
        {
          "name": "done",
          "description": "Order closed",
          "type": "DISPOSE",
          "position": [
            1500.0,
            320.0
          ],
          "params": {
            "distribution": "Constant",
            "dist_params": {
              "value": 0.0
            },
            "time_unit": "base"
          }
        }
