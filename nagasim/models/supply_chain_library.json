  ],
  "submodels": {
    "Customer demand": {
      "info": {
        "description": "A source of customer orders: arrivals at an interarrival time, each stamped with an order size in entity.scm_order. Chain it to a warehouse whose \"order size from the entity\" is on and every customer draws its own quantity. No input port -- this asset starts the flow.",
        "library": {"library": "supplychain", "asset": "customer_demand", "version": "1.0.0"},
        "parameters": [
          {
            "name": "interarrival_time",
            "type": "time",
            "default": 1.0,
            "unit": "days",
            "label": "Mean time between orders",
            "help": "",
            "group": "Demand",
            "min": 0.001,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "time_distribution",
            "type": "choice",
            "default": "exponential",
            "unit": "",
            "label": "Arrival distribution",
            "help": "exponential is the memoryless (Poisson) arrival stream; fixed is a metronome.",
            "group": "Demand",
            "min": null,
            "max": null,
            "choices": ["fixed", "exponential"],
            "refers_to": ""
          },
          {
            "name": "order_size",
            "type": "number",
            "default": 5.0,
            "unit": "units",
            "label": "Mean order size",
            "help": "",
            "group": "Demand",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "size_distribution",
            "type": "choice",
            "default": "fixed",
            "unit": "",
            "label": "Order size distribution",
            "help": "fixed is always the mean; uniform is between half and one and a half of it, rounded to whole units; triangular is the same range with the mean most likely.",
            "group": "Demand",
            "min": null,
            "max": null,
            "choices": ["fixed", "uniform", "triangular"],
            "refers_to": ""
          },
          {
            "name": "entity_type",
            "type": "name",
            "default": "CUSTOMER",
            "unit": "",
            "label": "Entity type",
            "help": "",
            "group": "Demand",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": "entity"
          }
        ]
      },
      "parameters": [
        {"name": "interarrival_time", "default": 1.0, "type": "time"},
        {
          "name": "time_distribution",
          "default": "exponential",
          "type": "choice",
          "description": "exponential is the memoryless (Poisson) arrival stream; fixed is a metronome."
        },
        {"name": "order_size", "default": 5.0, "type": "number"},
        {
          "name": "size_distribution",
          "default": "fixed",
          "type": "choice",
          "description": "fixed is always the mean; uniform is between half and one and a half of it, rounded to whole units; triangular is the same range with the mean most likely."
        },
        {"name": "entity_type", "default": "CUSTOMER", "type": "name", "refers_to": "entity"}
      ],
      "blocks": [
        {
          "name": "arrive",
          "type": "CREATE",
          "description": "Customer orders",
          "position": [0.0, 0.0],
          "params": {
            "e_type": {"$arg": "entity_type"},
            "dist_params": {
              "value": "interarrival_time if time_distribution == 'fixed' else EXPO(interarrival_time)"
            },
            "time_unit": "days"
          }
        },
        {
          "name": "size",
          "type": "ASSIGN",
          "description": "Order size",
          "position": [200.0, 0.0],
          "params": {
            "assignments": [
              {
                "target": "entity.scm_order",
                "expr": "order_size if size_distribution == 'fixed' else (round(UNIF(0.5 * order_size, 1.5 * order_size)) if size_distribution == 'uniform' else TRIA(0.5 * order_size, order_size, 1.5 * order_size))"
              }
            ]
          }
        },
        {
          "name": "out",
          "type": "SUB_EXIT",
          "description": "Orders leave",
          "position": [400.0, 0.0],
          "params": {"port": "orders"}
        }
      ],
      "links": [{"source": "arrive", "target": "size"}, {"source": "size", "target": "out"}],
      "annotations": []
    },
    "Warehouse (s,S / R,Q)": {
      "info": {
        "description": "Stock on a shelf, drawn by the order entities arriving at the demand port and replenished by a policy. (s, S) orders up to S when the inventory position falls to the reorder point; (R, Q) orders a fixed quantity. Review is continuous -- the stock level itself fires the reorder, exactly at the crossing -- or periodic on a review period. A shortage is a backorder (the entity waits at the shelf until the stock can pay in full) or a lost sale (it leaves by the \"lost\" port). Replenishment is either an internal lead time, or external: the order entity leaves by the \"orders\" port, and whatever answers it comes back through \"deliveries\" -- chain that to an upstream warehouse or to a supplier and the chain is two-echelon. Statistics: fill rate (orders servable on arrival), units served and lost, orders placed, and the stock level's own average, minimum and time empty.",
        "library": {"library": "supplychain", "asset": "warehouse", "version": "1.0.0"},
        "parameters": [
          {
            "name": "initial_stock",
            "type": "number",
            "default": 100.0,
            "unit": "units",
            "label": "Initial stock",
            "help": "",
            "group": "Stock",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "units_per_order",
            "type": "number",
            "default": 1.0,
            "unit": "units",
            "label": "Units per order",
            "help": "How much one arriving order draws, when it does not carry a size of its own.",
            "group": "Stock",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "order_from_entity",
            "type": "bool",
            "default": false,
            "unit": "",
            "label": "Order size from the entity",
            "help": "On: each arriving entity draws its own entity.scm_order units, which is what the Customer demand source stamps and what an upstream warehouse's replenishment order carries. Off: every order draws \"units per order\".",
            "group": "Stock",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "policy",
            "type": "choice",
            "default": "sS",
            "unit": "",
            "label": "Replenishment policy",
            "help": "sS: order back up to S. RQ: order a fixed quantity.",
            "group": "Policy",
            "min": null,
            "max": null,
            "choices": ["sS", "RQ"],
            "refers_to": ""
          },
          {
            "name": "reorder_point",
            "type": "number",
            "default": 50.0,
            "unit": "units",
            "label": "Reorder point (s)",
            "help": "Order when the inventory position -- stock on hand plus stock on order -- reaches this.",
            "group": "Policy",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "order_up_to",
            "type": "number",
            "default": 120.0,
            "unit": "units",
            "label": "Order up to (S)",
            "help": "Used by the (s, S) policy.",
            "group": "Policy",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "order_quantity",
            "type": "number",
            "default": 70.0,
            "unit": "units",
            "label": "Order quantity (Q)",
            "help": "Used by the (R, Q) policy.",
            "group": "Policy",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "review",
            "type": "choice",
            "default": "continuous",
            "unit": "",
            "label": "Review",
            "help": "continuous: the stock level fires the reorder the instant it crosses s, and one order is outstanding at a time. periodic: the position is checked every review period, and several orders may be in flight.",
            "group": "Policy",
            "min": null,
            "max": null,
            "choices": ["continuous", "periodic"],
            "refers_to": ""
          },
          {
            "name": "review_period",
            "type": "time",
            "default": 7.0,
            "unit": "days",
            "label": "Review period",
            "help": "Only used by periodic review.",
            "group": "Policy",
            "min": 0.01,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "allow_backorder",
            "type": "bool",
            "default": true,
            "unit": "",
            "label": "Backorders allowed",
            "help": "On: an order the shelf cannot fill waits at it, and is served the exact instant the stock reaches the amount. Off: it is a lost sale and leaves by the \"lost\" port.",
            "group": "Policy",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "replenishment",
            "type": "choice",
            "default": "internal",
            "unit": "",
            "label": "Replenishment",
            "help": "internal: the order is delivered after the lead time below. external: the order entity leaves by the \"orders\" port and the goods arrive back through \"deliveries\" -- chain it to a supplier or to an upstream warehouse.",
            "group": "Supply",
            "min": null,
            "max": null,
            "choices": ["internal", "external"],
            "refers_to": ""
          },
          {
            "name": "lead_time",
            "type": "time",
            "default": 2.0,
            "unit": "days",
            "label": "Lead time",
            "help": "Only used by internal replenishment.",
            "group": "Supply",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "lead_time_distribution",
            "type": "choice",
            "default": "fixed",
            "unit": "",
            "label": "Lead time distribution",
            "help": "Shape around the mean: fixed, memoryless, or between 50% and 150% of it.",
            "group": "Supply",
            "min": null,
            "max": null,
            "choices": ["fixed", "exponential", "triangular"],
            "refers_to": ""
          },
          {
            "name": "holding_cost",
            "type": "number",
            "default": 0.0,
            "unit": "EUR/unit/day",
            "label": "Holding cost",
            "help": "Charged on the stock on hand, integrated exactly over the stock curve and joined into Total Cost. A fixed cost PER ORDER is not a rate, so it is not a cost the engine can accrue: multiply the \"Scm orders placed\" statistic by it in the report or in an optimizer objective.",
            "group": "Cost",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          }
        ],
        "catalogue": {
          "catalogue": "Scm service policies",
          "label": "Service policy",
          "group": "Policy",
          "map": {
            "reorder_point": "reorder_point",
            "order_up_to": "order_up_to",
            "lead_time": "lead_time",
            "shortage": "allow_backorder"
          },
          "rows": ["Fast mover, backorders", "Fast mover, lost sales", "Slow mover, long lead time"],
          "units": {"reorder_point": "units", "order_up_to": "units", "lead_time": "days"},
          "values": {
            "Fast mover, backorders": {
              "reorder_point": 50.0,
              "order_up_to": 120.0,
              "lead_time": 2.0,
              "allow_backorder": true
            },
            "Fast mover, lost sales": {
              "reorder_point": 80.0,
              "order_up_to": 160.0,
              "lead_time": 2.0,
              "allow_backorder": false
            },
            "Slow mover, long lead time": {
              "reorder_point": 20.0,
              "order_up_to": 60.0,
              "lead_time": 10.0,
              "allow_backorder": true
            }
          },
          "sources": {
            "Fast mover, backorders": "Illustrative starting point (Naga); not measured data.",
            "Fast mover, lost sales": "Illustrative starting point (Naga); not measured data.",
            "Slow mover, long lead time": "Illustrative starting point (Naga); not measured data."
          }
        }
      },
      "parameters": [
        {"name": "initial_stock", "default": 100.0, "type": "number"},
        {
          "name": "units_per_order",
          "default": 1.0,
          "type": "number",
          "description": "How much one arriving order draws, when it does not carry a size of its own."
        },
        {
          "name": "order_from_entity",
          "default": false,
          "type": "bool",
          "description": "On: each arriving entity draws its own entity.scm_order units, which is what the Customer demand source stamps and what an upstream warehouse's replenishment order carries. Off: every order draws \"units per order\"."
        },
        {
          "name": "policy",
          "default": "sS",
          "type": "choice",
          "description": "sS: order back up to S. RQ: order a fixed quantity."
        },
        {
          "name": "reorder_point",
          "default": 50.0,
          "type": "number",
          "description": "Order when the inventory position -- stock on hand plus stock on order -- reaches this."
        },
        {
          "name": "order_up_to",
          "default": 120.0,
          "type": "number",
          "description": "Used by the (s, S) policy."
        },
        {
          "name": "order_quantity",
          "default": 70.0,
          "type": "number",
          "description": "Used by the (R, Q) policy."
        },
        {
          "name": "review",
          "default": "continuous",
          "type": "choice",
          "description": "continuous: the stock level fires the reorder the instant it crosses s, and one order is outstanding at a time. periodic: the position is checked every review period, and several orders may be in flight."
        },
        {
          "name": "review_period",
          "default": 7.0,
          "type": "time",
          "description": "Only used by periodic review."
        },
        {
          "name": "allow_backorder",
          "default": true,
          "type": "bool",
          "description": "On: an order the shelf cannot fill waits at it, and is served the exact instant the stock reaches the amount. Off: it is a lost sale and leaves by the \"lost\" port."
        },
        {
          "name": "replenishment",
          "default": "internal",
          "type": "choice",
          "description": "internal: the order is delivered after the lead time below. external: the order entity leaves by the \"orders\" port and the goods arrive back through \"deliveries\" -- chain it to a supplier or to an upstream warehouse."
        },
        {
          "name": "lead_time",
          "default": 2.0,
          "type": "time",
          "description": "Only used by internal replenishment."
        },
        {
          "name": "lead_time_distribution",
          "default": "fixed",
          "type": "choice",
          "description": "Shape around the mean: fixed, memoryless, or between 50% and 150% of it."
        },
        {
          "name": "holding_cost",
          "default": 0.0,
          "type": "number",
          "description": "Charged on the stock on hand, integrated exactly over the stock curve and joined into Total Cost."
        },
        {
          "name": "order_cost",
          "default": 0.0,
          "type": "number",
          "description": "Charged once every time a replenishment order is placed, whatever its size -- paperwork, a truck, a setup at the supplier. It joins Total Cost and is itemised in the cost summary as \"Scm ordering cost\"."
        },
        {
          "name": "lost_sale_penalty",
          "default": 0.0,
          "type": "number",
          "description": "Charged per unit of demand the shelf could not fill (lost sales only: a backordered unit is served late, not lost). It joins Total Cost and is itemised as \"Scm lost sales\"."
        }
      ],
      "scoped": {
        "levels": {
          "Scm Stock": {
            "initial": {"$arg": "initial_stock"},
            "thresholds.0.value": "reorder_point if review == \"continuous\" else -1e12"
          },
          "Scm On order": {}
        },
        "flows": {"Scm holding cost": {"price": {"$arg": "holding_cost"}}}
      },
      "blocks": [
        {
          "name": "in",
          "type": "SUB_ENTRY",
          "description": "Orders arrive",
          "position": [0.0, 0.0],
          "params": {"port": "demand"}
        },
        {
          "name": "size",
          "type": "ASSIGN",
          "description": "Order size and whether the shelf can fill it",
          "position": [150.0, 0.0],
          "params": {
            "assignments": [
              {
                "target": "entity.scm_qty",
                "expr": "entity.scm_order if order_from_entity else units_per_order"
              },
              {
                "target": "entity.scm_filled",
                "expr": "1 if LEVEL(\"$Scm Stock\") >= entity.scm_qty else 0"
              }
            ]
          }
        },
        {
          "name": "fill",
          "type": "RECORD",
          "description": "Fill rate",
          "position": [300.0, 0.0],
          "params": {"stat_name": "$Scm fill rate", "kind": "tally", "expr": "entity.scm_filled"}
        },
        {
          "name": "check",
          "type": "DECIDE",
          "description": "Serve or lose the sale",
          "position": [450.0, 0.0],
          "params": {
            "mode": "Condition",
            "conditions": ["1 if allow_backorder else entity.scm_filled"]
          }
        },
        {
          "name": "draw",
          "type": "TRANSFER",
          "description": "Take the units off the shelf",
          "position": [600.0, -60.0],
          "params": {
            "level": "$Scm Stock",
            "amount": "entity.scm_qty",
            "wait": {"$arg": "allow_backorder"}
          }
        },
        {
          "name": "served",
          "type": "RECORD",
          "description": "Units served",
          "position": [750.0, -60.0],
          "params": {"stat_name": "$Scm units served", "expr": "entity.scm_qty"}
        },
        {
          "name": "out",
          "type": "SUB_EXIT",
          "description": "Served orders leave",
          "position": [900.0, -60.0],
          "params": {"port": "served"}
        },
        {
          "name": "lost_units",
          "type": "RECORD",
          "description": "Units lost",
          "position": [750.0, 60.0],
          "params": {"stat_name": "$Scm units lost", "expr": "entity.scm_qty"}
        },
        {
          "name": "lost_charge",
          "type": "RECORD",
          "description": "Lost-sale penalty",
          "position": [750.0, 120.0],
          "params": {
            "stat_name": "$Scm lost sales",
            "kind": "cost",
            "expr": "entity.scm_qty * lost_sale_penalty",
            "category": "Penalty"
          }
        },
        {
          "name": "lost",
          "type": "SUB_EXIT",
          "description": "Lost sales leave",
          "position": [900.0, 60.0],
          "params": {"port": "lost"}
        },
        {
          "name": "agent",
          "type": "CREATE",
          "description": "One purchasing agent",
          "position": [0.0, 200.0],
          "params": {"e_type": "SCM_ORDER", "time_unit": "days", "max_arrivals": 1}
        },
        {
          "name": "wait_signal",
          "type": "HOLD",
          "description": "Wait for the stock to reach s",
          "position": [150.0, 200.0],
          "params": {"signal_name": "$Scm reorder"}
        },
        {
          "name": "clock",
          "type": "CREATE",
          "description": "Periodic review",
          "position": [0.0, 320.0],
          "params": {
            "e_type": "SCM_ORDER",
            "dist_params": {"value": "review_period"},
            "time_unit": "days"
          }
        },
        {
          "name": "due",
          "type": "DECIDE",
          "description": "Is the position at or below s?",
          "position": [150.0, 320.0],
          "params": {
            "mode": "Condition",
            "conditions": [
              "(review == \"periodic\") * (LEVEL(\"$Scm Stock\") + LEVEL(\"$Scm On order\") <= reorder_point)"
            ]
          }
        },
        {
          "name": "place",
          "type": "ASSIGN",
          "description": "Order quantity",
          "position": [300.0, 260.0],
          "params": {
            "assignments": [
              {
                "target": "entity.scm_order",
                "expr": "max(order_up_to - LEVEL(\"$Scm Stock\") - LEVEL(\"$Scm On order\"), 0) if policy == \"sS\" else order_quantity"
              }
            ]
          }
        },
        {
          "name": "orders",
          "type": "RECORD",
          "description": "Orders placed",
          "position": [450.0, 260.0],
          "params": {"stat_name": "$Scm orders placed"}
        },
        {
          "name": "order_charge",
          "type": "RECORD",
          "description": "Ordering cost",
          "position": [525.0, 200.0],
          "params": {
            "stat_name": "$Scm ordering cost",
            "kind": "cost",
            "expr": "order_cost",
            "category": "Ordering"
          }
        },
        {
          "name": "on_order",
          "type": "TRANSFER",
          "description": "Add it to the stock on order",
          "position": [600.0, 260.0],
          "params": {"level": "$Scm On order", "amount": "entity.scm_order", "mode": "add"}
        },
        {
          "name": "route",
          "type": "DECIDE",
          "description": "Internal lead time or a real supplier",
          "position": [750.0, 260.0],
          "params": {
            "mode": "Condition",
            "conditions": ["1 if replenishment == \"internal\" else 0"]
          }
        },
        {
          "name": "lead",
          "type": "DELAY",
          "description": "Supplier lead time",
          "position": [900.0, 200.0],
          "params": {
            "dist_params": {
              "value": "lead_time if lead_time_distribution == 'fixed' else (EXPO(lead_time) if lead_time_distribution == 'exponential' else TRIA(0.5 * lead_time, lead_time, 1.5 * lead_time))"
            },
            "time_unit": "days"
          }
        },
        {
          "name": "orders_out",
          "type": "SUB_EXIT",
          "description": "Orders to the supplier",
          "position": [900.0, 320.0],
          "params": {"port": "orders"}
        },
        {
          "name": "deliveries",
          "type": "SUB_ENTRY",
          "description": "Goods arrive",
          "position": [900.0, 400.0],
          "params": {"port": "deliveries"}
        },
        {
          "name": "arrive",
          "type": "TRANSFER",
          "description": "It is no longer on order",
          "position": [1050.0, 260.0],
          "params": {"level": "$Scm On order", "amount": "entity.scm_order"}
        },
        {
          "name": "receive",
          "type": "TRANSFER",
          "description": "Put it on the shelf",
          "position": [1200.0, 260.0],
          "params": {"level": "$Scm Stock", "amount": "entity.scm_order", "mode": "add"}
        },
        {
          "name": "loop",
          "type": "DECIDE",
          "description": "Back to waiting, or done",
          "position": [1350.0, 260.0],
          "params": {"mode": "Condition", "conditions": ["1 if review == \"continuous\" else 0"]}
        },
        {
          "name": "skip",
          "type": "DISPOSE",
          "description": "No order this period",
          "position": [300.0, 400.0]
        },
        {
          "name": "done",
          "type": "DISPOSE",
          "description": "Order closed",
          "position": [1500.0, 320.0]
        }
      ],
      "links": [
