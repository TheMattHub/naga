  "submodels": {
    "Customer demand": {
      "info": {
        "description": "A source of customer orders: arrivals at an interarrival time, each stamped with an order size in entity.scm_order. Chain it to a warehouse whose \"order size from the entity\" is on and every customer draws its own quantity. No input port -- this asset starts the flow.",
        "library": {
          "library": "supplychain",
          "asset": "customer_demand",
          "version": "1.0.0"
        },
        "parameters": [
          {
            "name": "interarrival_time",
            "type": "time",
            "default": 1.0,
            "unit": "days",
            "label": "Mean time between orders",
            "help": "",
            "group": "Demand",
            "min": 0.001,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "time_distribution",
            "type": "choice",
            "default": "exponential",
            "unit": "",
            "label": "Arrival distribution",
            "help": "exponential is the memoryless (Poisson) arrival stream; fixed is a metronome.",
            "group": "Demand",
            "min": null,
            "max": null,
            "choices": [
              "fixed",
              "exponential"
            ],
            "refers_to": ""
          },
          {
            "name": "order_size",
            "type": "number",
            "default": 5.0,
            "unit": "units",
            "label": "Mean order size",
            "help": "",
            "group": "Demand",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "size_distribution",
            "type": "choice",
            "default": "fixed",
            "unit": "",
            "label": "Order size distribution",
            "help": "fixed is always the mean; uniform is between half and one and a half of it, rounded to whole units; triangular is the same range with the mean most likely.",
            "group": "Demand",
            "min": null,
            "max": null,
            "choices": [
              "fixed",
              "uniform",
              "triangular"
            ],
            "refers_to": ""
          },
          {
            "name": "entity_type",
            "type": "name",
            "default": "CUSTOMER",
            "unit": "",
            "label": "Entity type",
            "help": "",
            "group": "Demand",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": "entity"
          }
        ]
      },
      "parameters": [
        {
          "name": "interarrival_time",
          "default": 1.0,
          "type": "time"
        },
        {
          "name": "time_distribution",
          "default": "exponential",
          "type": "choice",
          "description": "exponential is the memoryless (Poisson) arrival stream; fixed is a metronome."
        },
        {
          "name": "order_size",
          "default": 5.0,
          "type": "number"
        },
        {
          "name": "size_distribution",
          "default": "fixed",
          "type": "choice",
          "description": "fixed is always the mean; uniform is between half and one and a half of it, rounded to whole units; triangular is the same range with the mean most likely."
        },
        {
          "name": "entity_type",
          "default": "CUSTOMER",
          "type": "name",
          "refers_to": "entity"
        }
      ],
      "blocks": [
        {
          "name": "arrive",
          "description": "Customer orders",
          "type": "CREATE",
          "position": [
            0.0,
            0.0
          ],
          "params": {
            "e_type": {
              "$arg": "entity_type"
            },
            "arrival_mode": "Interarrival",
            "distribution": "Constant",
            "dist_params": {
              "value": "interarrival_time if time_distribution == 'fixed' else EXPO(interarrival_time)"
            },
            "time_unit": "days",
            "entities_per_arrival": 1,
            "max_arrivals": 0,
            "start_time": 0,
            "sequence": ""
          }
        },
        {
          "name": "size",
          "description": "Order size",
          "type": "ASSIGN",
          "position": [
            200.0,
            0.0
          ],
          "params": {
            "assignments": [
              {
                "target": "entity.scm_order",
                "expr": "order_size if size_distribution == 'fixed' else (round(UNIF(0.5 * order_size, 1.5 * order_size)) if size_distribution == 'uniform' else TRIA(0.5 * order_size, order_size, 1.5 * order_size))"
              }
            ]
          }
        },
        {
          "name": "out",
          "description": "Orders leave",
          "type": "SUB_EXIT",
          "position": [
            400.0,
            0.0
          ],
          "params": {
            "port": "orders"
          }
        }
      ],
      "links": [
        {
          "source": "arrive",
          "target": "size"
        },
        {
          "source": "size",
          "target": "out"
        }
      ],
      "annotations": []
    },
    "Warehouse (s,S / R,Q)": {
      "info": {
        "description": "Stock on a shelf, drawn by the order entities arriving at the demand port and replenished by a policy. (s, S) orders up to S when the inventory position falls to the reorder point; (R, Q) orders a fixed quantity. Review is continuous -- the stock level itself fires the reorder, exactly at the crossing -- or periodic on a review period. A shortage is a backorder (the entity waits at the shelf until the stock can pay in full) or a lost sale (it leaves by the \"lost\" port). Replenishment is either an internal lead time, or external: the order entity leaves by the \"orders\" port, and whatever answers it comes back through \"deliveries\" -- chain that to an upstream warehouse or to a supplier and the chain is two-echelon. Statistics: fill rate (orders servable on arrival), units served and lost, orders placed, and the stock level's own average, minimum and time empty.",
        "library": {
          "library": "supplychain",
          "asset": "warehouse",
          "version": "1.0.0"
        },
        "parameters": [
          {
            "name": "initial_stock",
            "type": "number",
            "default": 100.0,
            "unit": "units",
            "label": "Initial stock",
            "help": "",
            "group": "Stock",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "units_per_order",
            "type": "number",
            "default": 1.0,
            "unit": "units",
            "label": "Units per order",
            "help": "How much one arriving order draws, when it does not carry a size of its own.",
            "group": "Stock",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "order_from_entity",
            "type": "bool",
            "default": false,
            "unit": "",
            "label": "Order size from the entity",
            "help": "On: each arriving entity draws its own entity.scm_order units, which is what the Customer demand source stamps and what an upstream warehouse's replenishment order carries. Off: every order draws \"units per order\".",
            "group": "Stock",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "policy",
            "type": "choice",
            "default": "sS",
            "unit": "",
            "label": "Replenishment policy",
            "help": "sS: order back up to S. RQ: order a fixed quantity.",
            "group": "Policy",
            "min": null,
            "max": null,
            "choices": [
              "sS",
              "RQ"
            ],
            "refers_to": ""
          },
          {
            "name": "reorder_point",
            "type": "number",
            "default": 50.0,
            "unit": "units",
            "label": "Reorder point (s)",
            "help": "Order when the inventory position -- stock on hand plus stock on order -- reaches this.",
            "group": "Policy",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "order_up_to",
            "type": "number",
            "default": 120.0,
            "unit": "units",
            "label": "Order up to (S)",
            "help": "Used by the (s, S) policy.",
            "group": "Policy",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "order_quantity",
            "type": "number",
            "default": 70.0,
            "unit": "units",
            "label": "Order quantity (Q)",
            "help": "Used by the (R, Q) policy.",
            "group": "Policy",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "review",
            "type": "choice",
            "default": "continuous",
            "unit": "",
            "label": "Review",
            "help": "continuous: the stock level fires the reorder the instant it crosses s, and one order is outstanding at a time. periodic: the position is checked every review period, and several orders may be in flight.",
            "group": "Policy",
            "min": null,
            "max": null,
            "choices": [
              "continuous",
              "periodic"
            ],
            "refers_to": ""
          },
          {
            "name": "review_period",
            "type": "time",
            "default": 7.0,
            "unit": "days",
            "label": "Review period",
            "help": "Only used by periodic review.",
            "group": "Policy",
            "min": 0.01,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "allow_backorder",
            "type": "bool",
            "default": true,
            "unit": "",
            "label": "Backorders allowed",
            "help": "On: an order the shelf cannot fill waits at it, and is served the exact instant the stock reaches the amount. Off: it is a lost sale and leaves by the \"lost\" port.",
            "group": "Policy",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "replenishment",
            "type": "choice",
            "default": "internal",
            "unit": "",
            "label": "Replenishment",
            "help": "internal: the order is delivered after the lead time below. external: the order entity leaves by the \"orders\" port and the goods arrive back through \"deliveries\" -- chain it to a supplier or to an upstream warehouse.",
            "group": "Supply",
            "min": null,
            "max": null,
            "choices": [
              "internal",
              "external"
            ],
            "refers_to": ""
          },
          {
            "name": "lead_time",
            "type": "time",
            "default": 2.0,
            "unit": "days",
            "label": "Lead time",
            "help": "Only used by internal replenishment.",
            "group": "Supply",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "lead_time_distribution",
            "type": "choice",
            "default": "fixed",
            "unit": "",
            "label": "Lead time distribution",
            "help": "Shape around the mean: fixed, memoryless, or between 50% and 150% of it.",
            "group": "Supply",
            "min": null,
            "max": null,
            "choices": [
              "fixed",
              "exponential",
              "triangular"
            ],
            "refers_to": ""
          },
          {
            "name": "holding_cost",
            "type": "number",
            "default": 0.0,
            "unit": "EUR/unit/day",
            "label": "Holding cost",
            "help": "Charged on the stock on hand, integrated exactly over the stock curve and joined into Total Cost. A fixed cost PER ORDER is not a rate, so it is not a cost the engine can accrue: multiply the \"Scm orders placed\" statistic by it in the report or in an optimizer objective.",
            "group": "Cost",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          }
        ],
        "catalogue": {
          "catalogue": "Scm service policies",
          "label": "Service policy",
          "group": "Policy",
          "map": {
