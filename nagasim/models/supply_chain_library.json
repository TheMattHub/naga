    "Supplier": {
      "info": {
        "description": "An upstream supplier with finite capacity: an order entity arriving at the \"orders\" port queues for one of the supplier's order slots, is handled for a picking time, then travels for a transport time and leaves by \"deliveries\". Chain a warehouse's \"orders\" port here and its \"deliveries\" port back, and the lead time stops being a number and becomes a queueing outcome -- which is the whole point of simulating a supply chain rather than adding up averages.",
        "library": {
          "library": "supplychain",
          "asset": "supplier",
          "version": "1.0.0"
        },
        "parameters": [
          {
            "name": "order_slots",
            "type": "int",
            "default": 1,
            "unit": "",
            "label": "Orders handled at once",
            "help": "Capacity of the supplier: orders beyond it queue.",
            "group": "Supplier",
            "min": 1,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "picking_time",
            "type": "time",
            "default": 1.0,
            "unit": "days",
            "label": "Mean picking time",
            "help": "",
            "group": "Supplier",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "time_distribution",
            "type": "choice",
            "default": "fixed",
            "unit": "",
            "label": "Picking time distribution",
            "help": "",
            "group": "Supplier",
            "min": null,
            "max": null,
            "choices": [
              "fixed",
              "exponential",
              "triangular"
            ],
            "refers_to": ""
          },
          {
            "name": "transport_time",
            "type": "time",
            "default": 1.0,
            "unit": "days",
            "label": "Transport time",
            "help": "Time in transit after picking; it does not use a slot.",
            "group": "Supplier",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "cost_per_order",
            "type": "number",
            "default": 0.0,
            "unit": "EUR/day",
            "label": "Cost while handling",
            "help": "Cost rate of a busy order slot; it joins Total Cost as a resource cost.",
            "group": "Cost",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          }
        ]
      },
      "parameters": [
        {
          "name": "order_slots",
          "default": 1,
          "type": "int",
          "description": "Capacity of the supplier: orders beyond it queue."
        },
        {
          "name": "picking_time",
          "default": 1.0,
          "type": "time"
        },
        {
          "name": "time_distribution",
          "default": "fixed",
          "type": "choice"
        },
        {
          "name": "transport_time",
          "default": 1.0,
          "type": "time",
          "description": "Time in transit after picking; it does not use a slot."
        },
        {
          "name": "cost_per_order",
          "default": 0.0,
          "type": "number",
          "description": "Cost rate of a busy order slot; it joins Total Cost as a resource cost."
        }
      ],
      "scoped": {
        "resources": {
          "Scm Supplier": {
            "capacity": "order_slots",
            "cost_busy": "cost_per_order"
          }
        }
      },
      "blocks": [
        {
          "name": "in",
          "description": "Orders arrive",
          "type": "SUB_ENTRY",
          "position": [
            0.0,
            0.0
          ],
          "params": {
            "port": "orders"
          }
        },
        {
          "name": "pick",
          "description": "Pick the order",
          "type": "PROCESS",
          "position": [
            200.0,
            0.0
          ],
          "params": {
            "action": "Seize Delay Release",
            "distribution": "Constant",
            "dist_params": {
              "value": "picking_time if time_distribution == 'fixed' else (EXPO(picking_time) if time_distribution == 'exponential' else TRIA(0.5 * picking_time, picking_time, 1.5 * picking_time))"
            },
            "time_unit": "days",
            "priority": 0,
            "quantity": 1,
            "resource_name": "$Scm Supplier"
          }
