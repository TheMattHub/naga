{
  "$schema": "https://thematthub.github.io/naga/schema/model-v29.json",
  "schema_version": 29,
  "blocks": [
    {
      "name": "create_1",
      "type": "CREATE",
      "description": "Poisson arrivals, 1.5/min",
      "position": [
        100.0,
        300.0
      ],
      "params": {
        "distribution": "Exponential",
        "dist_params": {
          "rate": 1.5
        }
      }
    },
    {
      "name": "decide_route",
      "type": "DECIDE",
      "description": "Route to the fast or slow server; policy 'routing'",
      "position": [
        340.0,
        300.0
      ],
      "params": {
        "mode": "Policy",
        "policy": "routing",
        "observation": [
          "NQ(\"ServerA\")",
          "NQ(\"ServerB\")",
          "NR(\"ServerA\")",
          "NR(\"ServerB\")"
        ]
      }
    },
    {
      "name": "process_a",
      "type": "PROCESS",
      "description": "Fast server, rate 2.0/min",
      "position": [
        600.0,
        160.0
      ],
      "params": {
        "distribution": "Exponential",
        "dist_params": {
          "rate": 2.0
        },
        "resource_name": "ServerA"
      }
    },
    {
      "name": "process_b",
      "type": "PROCESS",
      "description": "Slow server, rate 0.5/min",
      "position": [
        600.0,
        440.0
      ],
      "params": {
        "distribution": "Exponential",
        "dist_params": {
          "rate": 0.5
        },
        "resource_name": "ServerB"
      }
    },
    {
      "name": "dispose_1",
      "type": "DISPOSE",
      "description": "Jobs leave the system",
      "position": [
        860.0,
        300.0
      ]
    }
  ],
  "links": [
    {
      "source": "create_1",
      "target": "decide_route"
    },
    {
      "source": "decide_route",
      "target": "process_a"
    },
    {
      "source": "decide_route",
      "target": "process_b"
    },
    {
      "source": "process_a",
      "target": "dispose_1"
    },
    {
      "source": "process_b",
      "target": "dispose_1"
    }
  ],
  "resources": [
    {
      "name": "ServerA",
      "capacity": 1,
      "discipline": "FIFO"
    },
    {
      "name": "ServerB",
      "capacity": 1,
      "discipline": "FIFO"
    }
  ],
  "entities": [
    {
      "name": "DEFAULT",
      "shape": "circle",
      "color": "BLACK"
    }
  ],
  "info": {
    "title": "Policy-routed parallel servers",
    "category": "Teaching",
    "description": "Arrivals routed by a Policy-mode DECIDE ('routing') between a fast and a slow single server; observation is each server's queue length and in-service flag. With no controller attached it falls back to always routing to ServerA (fallback 'first'), so the model runs headless with no RL involved."
  },
  "simulation": {
    "time_limit": 2000,
    "warmup": 0,
    "replications": 1
  },
  "outputs": {}
}
