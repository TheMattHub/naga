{
  "$schema": "https://thematthub.github.io/naga/schema/model-v29.json",
  "schema_version": 29,
  "blocks": [
    {
      "name": "create_1",
      "type": "CREATE",
      "description": "External Poisson arrivals, 0.8/min",
      "position": [100.0, 200.0],
      "params": {"distribution": "Exponential", "dist_params": {"rate": 0.8}}
    },
    {
      "name": "cell_1",
      "type": "SUBMODEL",
      "description": "Cell 1 (rate 1.2/min)",
      "position": [320.0, 200.0],
      "layout_position": [3.0, 3.0],
      "params": {"definition": "Cell", "arguments": {"rate": 1.2}}
    },
    {
      "name": "cell_2",
      "type": "SUBMODEL",
      "description": "Cell 2 (rate 1.5/min)",
      "position": [540.0, 200.0],
      "layout_position": [14.0, 3.0],
      "params": {"definition": "Cell", "arguments": {"rate": 1.5}}
    },
    {
      "name": "record_exit",
      "type": "RECORD",
      "description": "Tally the end-to-end time in system",
      "position": [760.0, 200.0],
      "params": {
        "stat_name": "time_in_system",
        "kind": "tally",
        "expr": "TNOW - entity.creation_time"
      }
    },
    {
      "name": "dispose_1",
      "type": "DISPOSE",
      "description": "Jobs leave the line",
      "position": [980.0, 200.0]
    }
  ],
  "links": [
    {"source": "create_1", "target": "cell_1"},
    {"source": "cell_1", "target": "cell_2"},
    {"source": "cell_2", "target": "record_exit"},
    {"source": "record_exit", "target": "dispose_1"}
  ],
  "resources": [{"name": "Machine", "capacity": 1, "discipline": "FIFO"}],
  "entities": [{"name": "DEFAULT", "shape": "circle", "color": "BLACK"}],
  "submodels": {
    "Cell": {
      "info": {"description": "One work cell: a machine with a rework loop."},
      "parameters": [
        {
          "name": "rate",
          "default": 1.0,
          "description": "Service rate of one machine, per model time unit"
        },
        {
          "name": "servers",
          "default": 1,
          "description": "Machines in the cell; sets $Machine's capacity (a scoped override)"
        }
      ],
      "scoped": {"resources": {"Machine": {"capacity": "servers"}}},
      "blocks": [
        {
          "name": "in",
          "type": "SUB_ENTRY",
          "description": "Jobs enter the cell",
          "position": [0.0, 200.0]
        },
        {
          "name": "machine",
          "type": "PROCESS",
          "description": "Machine (per-instance resource, cloned from the Machine template; capacity = servers, a scoped override)",
          "position": [200.0, 200.0],
          "params": {
            "distribution": "Exponential",
            "dist_params": {"rate": "rate"},
            "time_unit": "minutes",
            "resource_name": "$Machine"
          }
        },
        {
          "name": "rework",
          "type": "DECIDE",
          "description": "10% of jobs are reworked on the same machine",
          "position": [400.0, 200.0],
          "params": {"probs": [0.1, 0.9]}
        },
        {
          "name": "out",
          "type": "SUB_EXIT",
          "description": "Jobs leave the cell",
          "position": [600.0, 200.0]
        }
      ],
      "links": [
        {"source": "in", "target": "machine"},
        {"source": "machine", "target": "rework"},
        {"source": "rework", "target": "machine"},
        {"source": "rework", "target": "out"}
      ],
      "annotations": []
    }
  },
  "info": {
    "title": "Two-cell line (reusable submodel)",
    "category": "Manufacturing",
    "description": "Two identical work cells built from one reusable submodel definition Cell(rate, servers): a machine on a per-instance `$Machine` resource with a 10% rework loop. An open Jackson network of two M/M/1 nodes with feedback."
  },
  "simulation": {"time_limit": 6000, "warmup": 1000, "replications": 10},
  "outputs": {}
}
