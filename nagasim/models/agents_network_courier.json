  "submodels": {
    "Courier on a path network": {
      "info": {
        "description": "One Courier agent moving on the model's own path network (`network`) instead of continuous space: it starts at a node named \"Dock\", is sent to a node named \"Dropoff\" the instant it starts, and enters Delivered on arrival. Needs the model to declare those two node names and a segment joining them -- validation reports E_AGENT_SPACE with a clear hint if they are missing. move_to's travel time is segment length / speed, exact, so a fixed leg gives an exact sojourn oracle just like the continuous walker asset.",
        "library": {
          "library": "agents",
          "asset": "network_courier",
          "version": "1.2.0"
        },
        "parameters": [
          {
            "name": "courier_speed",
