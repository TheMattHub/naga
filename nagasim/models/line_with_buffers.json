          "params": {
            "dist_params": {
              "value": "process_time if time_distribution == 'fixed' else (EXPO(process_time) if time_distribution == 'exponential' else TRIA(0.7 * process_time, process_time, 1.3 * process_time))"
            },
            "time_unit": "minutes",
