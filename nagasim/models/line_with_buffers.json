  "info": {
    "title": "Line with finite buffers",
    "category": "Manufacturing",
    "description": "A four-station line with finite buffers between the stations: when a buffer is full the machine behind it stays BLOCKED, holding its finished part. Station 3 breaks down often, so where the twelve available buffer places go decides the line's throughput -- the scenarios move them around without ever adding any."
  },
  "simulation": {
    "time_limit": 2400,
    "warmup": 240,
    "replications": 10
  },
  "outputs": {}
}
