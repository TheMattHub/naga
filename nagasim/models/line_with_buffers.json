    "Buffer": {
      "info": {
        "description": "The finite space between two stations. A job takes a place on the way in and keeps it until the next station starts it, so the station upstream stays BLOCKED -- occupied, holding its finished job -- while the buffer is full. 0 places is the classic zero-buffer line. For an unlimited queue, do not place a buffer at all.",
        "library": {
          "library": "manufacturing",
          "asset": "buffer",
          "version": "2.2.0"
        },
        "parameters": [
          {
            "name": "places",
            "type": "int",
            "default": 5,
            "unit": "",
            "label": "Places",
            "help": "How many jobs fit between the two stations. 0 means none at all: the upstream machine holds its finished job until the next station starts it.",
            "group": "Capacity",
            "min": 0,
            "max": 10000,
            "choices": [],
            "refers_to": ""
