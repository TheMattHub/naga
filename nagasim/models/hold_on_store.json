{
  "$schema": "https://thematthub.github.io/naga/schema/model-v29.json",
  "schema_version": 29,
  "blocks": [
    {
      "name": "cases_in",
      "type": "CREATE",
      "description": "Four cases arrive together every 10 minutes",
      "position": [120.0, 120.0],
      "params": {"e_type": "CASE", "dist_params": {"value": 10.0}, "entities_per_arrival": 4}
    },
    {
      "name": "pack",
      "type": "BATCH",
      "description": "Packs of three; the rest stay staged",
      "position": [360.0, 120.0],
      "params": {"batch_size": 3, "batched_entity_type": "PACK"}
    },
    {
      "name": "packs_out",
      "type": "DISPOSE",
      "description": "Packs leave",
      "position": [600.0, 120.0]
    },
    {
      "name": "trucks_in",
      "type": "CREATE",
      "description": "One truck every 7 minutes",
      "position": [120.0, 300.0],
      "params": {"e_type": "TRUCK", "dist_params": {"value": 7.0}}
    },
    {
      "name": "wait_for_cases",
      "type": "HOLD",
      "description": "Held until two cases are staged at the packer",
      "position": [360.0, 300.0],
      "params": {"mode": "Condition", "conditions": ["NS(\"pack\") >= 2"]}
    },
    {
      "name": "trucks_out",
      "type": "DISPOSE",
      "description": "Trucks leave",
      "position": [600.0, 300.0]
    }
  ],
  "links": [
    {"source": "cases_in", "target": "pack"},
    {"source": "pack", "target": "packs_out"},
    {"source": "trucks_in", "target": "wait_for_cases"},
    {"source": "wait_for_cases", "target": "trucks_out"}
  ],
  "entities": [{"name": "CASE"}, {"name": "PACK"}, {"name": "TRUCK"}],
  "info": {
    "title": "HOLD on a store's contents",
    "category": "Teaching",
    "description": "Trucks wait in a HOLD until two cases are staged at a packer. Cases arrive four at a time and are packed in threes, so the staged count rises and falls within one instant: the HOLD reads NS(\"pack\") and is re-evaluated when the store changes, not on a timer."
  },
  "simulation": {"time_limit": 100, "warmup": 0, "replications": 2},
  "outputs": {}
}
