{
  "$schema": "https://thematthub.github.io/naga/schema/model-v29.json",
  "schema_version": 29,
  "blocks": [
    {
      "name": "arrivals",
      "type": "CREATE",
      "description": "Poisson walk-in and ambulance arrivals",
      "position": [0.0, 260.0],
      "params": {
        "e_type": "PATIENT",
        "distribution": "Exponential",
        "dist_params": {"rate": 3.5},
        "population": "Patients"
      }
    },
    {
      "name": "divert_check",
      "type": "DECIDE",
      "description": "Diverting? Route a share of arrivals away, else straight to triage (ELSE link)",
      "position": [220.0, 260.0],
      "params": {"mode": "Condition", "conditions": ["diverting == 1"]}
    },
    {
      "name": "diversion_chance",
      "type": "DECIDE",
      "description": "60% of arrivals turned away while diverting, 40% still admitted (ELSE link)",
      "position": [440.0, 140.0],
      "params": {"probs": [0.6]}
    },
    {
      "name": "assign_diverted",
      "type": "ASSIGN",
      "description": "Count the diverted patient",
      "position": [660.0, 60.0],
      "params": {"assignments": [{"target": "diverted_count", "expr": "diverted_count + 1"}]}
    },
    {
      "name": "leave_diverted",
      "type": "DISPOSE",
      "description": "Diverted patient leaves without being seen; its agent goes with it",
      "position": [880.0, 60.0],
      "params": {"remove_agent": true}
    },
    {
      "name": "triage",
      "type": "PROCESS",
      "description": "Nurse assesses the patient",
      "position": [440.0, 260.0],
      "params": {
        "distribution": "Exponential",
        "dist_params": {"rate": 5.0},
        "resource_name": "Nurse"
      }
    },
    {
      "name": "seize_doctor",
      "type": "SEIZE",
      "description": "Joins the doctor's queue, ranked by highest entity.agent.acuity first (Doctor's own HighestValueFirst discipline)",
      "position": [660.0, 260.0],
      "params": {"resource_name": "Doctor"}
    },
    {
      "name": "treatment",
      "type": "DELAY",
      "description": "Doctor's service time",
      "position": [880.0, 260.0],
      "params": {"distribution": "Exponential", "dist_params": {"rate": 2.5}}
    },
    {
      "name": "release_doctor",
      "type": "RELEASE",
      "description": "Frees the doctor",
      "position": [1100.0, 260.0],
      "params": {"resource_name": "Doctor"}
    },
    {
      "name": "notify_treated",
      "type": "SEND",
      "description": "Messages entity.agent (the default target): its \"treated\" transition fires from whichever state it is currently in",
      "position": [1320.0, 260.0],
      "params": {"message": "treated"}
    },
    {
      "name": "time_in_system",
      "type": "RECORD",
      "description": "Time in system per patient",
      "position": [1540.0, 260.0],
      "params": {
        "stat_name": "time_in_system",
        "kind": "tally",
        "expr": "now - entity.creation_time"
      }
    },
    {
      "name": "leave",
      "type": "DISPOSE",
      "description": "Patient discharged; its agent is removed with it",
      "position": [1760.0, 260.0],
      "params": {"remove_agent": true}
    },
    {
      "name": "review_clock",
      "type": "CREATE",
      "description": "A review token every 8 hours: drives the ambulance-diversion policy, not a patient",
      "position": [0.0, 520.0],
      "params": {"e_type": "REVIEW", "dist_params": {"value": 8.0}}
    },
    {
      "name": "divert_decision",
      "type": "DECIDE",
      "description": "Ambulance-diversion policy 'divert', reviewed every 8 hours; falls back to staying open with no controller attached",
      "position": [220.0, 520.0],
      "params": {
        "mode": "Policy",
        "policy": "divert",
        "observation": ["NQ(\"Doctor\")", "NR(\"Doctor\") / MR(\"Doctor\")"]
      }
    },
    {
      "name": "assign_stay_open",
      "type": "ASSIGN",
      "description": "Option 0: stay open",
      "position": [440.0, 460.0],
      "params": {"assignments": [{"target": "diverting", "expr": "0"}]}
    },
    {
      "name": "assign_divert",
      "type": "ASSIGN",
      "description": "Option 1: divert ambulances",
      "position": [440.0, 580.0],
      "params": {"assignments": [{"target": "diverting", "expr": "1"}]}
    },
    {
      "name": "leave_review",
      "type": "DISPOSE",
      "description": "The review token has done its job",
      "position": [660.0, 520.0]
    }
  ],
  "links": [
    {"source": "arrivals", "target": "divert_check"},
    {"source": "divert_check", "target": "diversion_chance"},
    {"source": "divert_check", "target": "triage"},
    {"source": "diversion_chance", "target": "assign_diverted"},
    {"source": "diversion_chance", "target": "triage"},
    {"source": "assign_diverted", "target": "leave_diverted"},
    {"source": "triage", "target": "seize_doctor"},
    {"source": "seize_doctor", "target": "treatment"},
    {"source": "treatment", "target": "release_doctor"},
    {"source": "release_doctor", "target": "notify_treated"},
    {"source": "notify_treated", "target": "time_in_system"},
    {"source": "time_in_system", "target": "leave"},
    {"source": "review_clock", "target": "divert_decision"},
    {"source": "divert_decision", "target": "assign_stay_open"},
    {"source": "divert_decision", "target": "assign_divert"},
    {"source": "assign_stay_open", "target": "leave_review"},
    {"source": "assign_divert", "target": "leave_review"}
  ],
  "resources": [
    {"name": "Nurse", "capacity": 3, "discipline": "FIFO"},
    {
      "name": "Doctor",
      "capacity": 4,
      "discipline": "HighestValueFirst",
      "ranking_expr": "entity.agent.acuity",
      "rerank": true
    }
  ],
  "variables": [{"name": "diverting", "initial": 0}, {"name": "diverted_count", "initial": 0}],
  "entities": [
    {"name": "PATIENT", "shape": "circle", "color": "red"},
    {"name": "REVIEW", "shape": "circle", "color": "gray"}
  ],
  "agent_types": [
    {
      "name": "Patient",
      "description": "An ED patient's clinical trajectory while it waits: it may worsen before a doctor is free, which is what the doctor's queue ranking (highest entity.agent.acuity first) then reacts to.",
      "attributes": [{"name": "acuity", "init": "1"}],
      "states": [
        {"name": "Stable", "color": "GREEN"},
        {"name": "Deteriorating", "color": "ORANGE"},
        {"name": "Critical", "color": "RED"},
        {"name": "Discharged", "color": "GRAY"}
      ],
      "transitions": [
        {
          "from": "Stable",
          "to": "Deteriorating",
          "rate": "1.5",
          "actions": [{"target": "self.acuity", "expr": "2"}],
          "rate_unit": "hours"
        },
        {
          "from": "Deteriorating",
          "to": "Critical",
          "rate": "1.5",
          "actions": [{"target": "self.acuity", "expr": "3"}],
          "rate_unit": "hours"
        },
        {"from": "Stable", "to": "Discharged", "message": "treated"},
        {"from": "Deteriorating", "to": "Discharged", "message": "treated"},
        {"from": "Critical", "to": "Discharged", "message": "treated"}
      ],
      "initial_state": "Stable"
    }
  ],
  "populations": [{"name": "Patients", "type": "Patient", "count": 0, "max_count": 400}],
  "info": {
    "title": "Emergency department: staffing game",
    "category": "Games",
    "description": "A staffing game built on ed_patient_agents: patients run the same Stable -> Deteriorating -> Critical statechart through triage and a Doctor queue ranked by entity.agent.acuity. Two controls let a player staff Doctor (1-4) and Nurse (1-3) up or down mid-run; every 8 hours a Policy-mode DECIDE ('divert') asks whether to divert ambulances, which turns away 60% of new arrivals until reviewed again. In the results, read the doctor queue, doctor utilisation, waiting against critical patients, the acuity mix and the diverted count.",
    "author": "Naga example"
  },
  "simulation": {"time_limit": 96.0, "warmup": 8.0, "replications": 3, "time_unit": "hours"},
  "outputs": {},
  "dashboard": {
    "widgets": [
      {"name": "waiting", "kind": "kpi", "title": "Patients waiting", "expr": "NQ(\"Doctor\")"},
      {
        "name": "doctor_util",
        "kind": "gauge",
        "title": "Doctor utilisation",
        "expr": "NR(\"Doctor\") / MR(\"Doctor\")",
        "min": 0,
        "max": 1,
        "thresholds": [0.7, 0.9]
      },
      {
        "name": "waiting_and_critical",
        "kind": "line",
        "title": "Waiting vs critical patients",
        "series": [
          {"label": "Waiting", "expr": "NQ(\"Doctor\")"},
          {"label": "Critical", "expr": "COUNT(\"Patients\", \"Critical\")"}
        ]
      },
      {
        "name": "acuity_mix",
        "kind": "bar",
        "title": "Patients by acuity",
        "series": [
          {"label": "Stable", "expr": "COUNT(\"Patients\", \"Stable\")"},
          {"label": "Deteriorating", "expr": "COUNT(\"Patients\", \"Deteriorating\")"},
          {"label": "Critical", "expr": "COUNT(\"Patients\", \"Critical\")"}
        ]
      },
      {"name": "diverted", "kind": "kpi", "title": "Ambulances diverted", "expr": "diverted_count"}
    ],
    "controls": [
      {
        "name": "doctor_capacity",
        "kind": "slider",
        "title": "Doctors on duty",
        "target": {"capacity": "Doctor"},
        "min": 1,
        "max": 4,
        "step": 1
      },
      {
        "name": "nurse_capacity",
        "kind": "slider",
        "title": "Triage nurses on duty",
        "target": {"capacity": "Nurse"},
        "min": 1,
        "max": 3,
        "step": 1
      },
      {
        "name": "divert",
        "kind": "decision",
        "title": "Ambulance diversion (reviewed every 8h)",
        "policy": "divert",
        "options": ["Stay open", "Divert"]
      }
    ]
  }
}
