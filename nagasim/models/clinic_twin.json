{
  "$schema": "https://thematthub.github.io/naga/schema/model-v29.json",
  "schema_version": 29,
  "blocks": [
    {
      "name": "arrivals",
      "type": "CREATE",
      "description": "Walk-in patients; the rate profile is read from the visit log",
      "position": [0.0, 200.0],
      "params": {
        "e_type": "PATIENT",
        "arrival_mode": "Schedule",
        "schedule_name": "arrivals",
        "distribution": "Exponential",
        "dist_params": {"rate": 0.15}
      }
    },
    {
      "name": "Reception",
      "type": "PROCESS",
      "description": "Check-in at the desk",
      "position": [220.0, 200.0],
      "layout_position": [3.0, 3.0],
      "params": {
        "distribution": "Exponential",
        "dist_params": {"rate": 0.5},
        "resource_name": "Clerk"
      }
    },
    {
      "name": "Consult",
      "type": "PROCESS",
      "description": "Consultation; the distribution is fitted from the visit log",
      "position": [440.0, 200.0],
      "layout_position": [14.0, 3.0],
      "params": {
        "distribution": "Exponential",
        "dist_params": {"rate": 0.1111111111111111},
        "resource_name": "Doctor"
      }
    },
    {
      "name": "time_in_system",
      "type": "RECORD",
      "description": "Time in system per patient",
      "position": [660.0, 200.0],
      "params": {
        "stat_name": "time_in_system",
        "kind": "tally",
        "expr": "now - entity.creation_time"
      }
    },
    {
      "name": "leave",
      "type": "DISPOSE",
      "description": "Patient leaves",
      "position": [880.0, 200.0]
    }
  ],
  "links": [
    {"source": "arrivals", "target": "Reception"},
    {"source": "Reception", "target": "Consult"},
    {"source": "Consult", "target": "time_in_system"},
    {"source": "time_in_system", "target": "leave"}
  ],
  "resources": [
    {"name": "Clerk", "capacity": 1, "discipline": "FIFO"},
    {"name": "Doctor", "capacity": 2, "discipline": "FIFO"}
  ],
  "schedules": [
    {
      "name": "arrivals",
      "kind": "arrival",
      "repeat": false,
      "points": [
        [60.0, 0.15],
        [60.0, 0.15],
        [60.0, 0.15],
        [60.0, 0.15],
        [60.0, 0.15],
        [60.0, 0.15],
        [60.0, 0.15],
        [60.0, 0.15]
      ]
    }
  ],
  "entities": [{"name": "PATIENT", "shape": "circle", "color": "blue"}],
  "info": {
    "title": "Walk-in clinic digital twin",
    "category": "Services",
    "description": "Walk-in clinic as a digital twin: the consultation time and the arrival profile are read from data/clinic_visits.csv at run time, and the day starts with a waiting room that is already half full. Forecast it with: naga forecast clinic_twin --horizon 480 --replications 200 --event \"timeseries/resource/Doctor/queue/max>8\"",
    "author": "Naga example"
  },
  "data_sources": [
    {
      "name": "visits",
      "kind": "csv",
      "location": "data/clinic_visits.csv",
      "description": "One row per visit: arrival time and consultation time"
    }
  ],
  "data_bindings": [
    {
      "name": "consultation_time",
      "source": "visits",
      "column": "service_minutes",
      "filter": {"clinic": "north"},
      "transform": "fit",
      "target": "blocks.Consult.params.distribution",
      "enabled": true,
      "description": "Best-AIC fit of the measured consultation times"
    },
    {
      "name": "arrival_profile",
      "source": "visits",
      "column": "arrival_minute",
      "transform": "arrival_schedule:60",
      "target": "schedules.arrivals.points",
      "enabled": true,
      "description": "Hourly arrival rates measured from the visit log"
    }
  ],
  "initial_state": {
    "time": 0.0,
    "entities": [
      {
        "block": "Consult",
        "count": 4,
        "e_type": "PATIENT",
        "age": 12.0,
        "in_service": 1,
        "remaining": [6.0],
        "age_unit": "minutes"
      },
      {"block": "Reception", "count": 1, "e_type": "PATIENT", "age": 2.0, "age_unit": "minutes"}
    ],
    "time_unit": "minutes"
  },
  "simulation": {"time_limit": 480.0, "warmup": 0, "replications": 20},
  "outputs": {}
}
