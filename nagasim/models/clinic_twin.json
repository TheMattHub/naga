{
  "schema_version": 29,
  "blocks": [
    {
      "name": "arrivals",
      "description": "Walk-in patients; the rate profile is read from the visit log",
      "type": "CREATE",
      "position": [
        0.0,
        200.0
      ],
      "params": {
        "e_type": "PATIENT",
        "arrival_mode": "Schedule",
        "schedule_name": "arrivals",
        "distribution": "Exponential",
        "dist_params": {
          "rate": 0.15
        },
        "entities_per_arrival": 1,
        "max_arrivals": 0,
        "start_time": 0,
        "time_unit": "minutes",
        "start_time_unit": "minutes"
      }
    },
    {
      "name": "Reception",
      "description": "Check-in at the desk",
      "type": "PROCESS",
      "position": [
        220.0,
        200.0
      ],
      "layout_position": [
        3.0,
        3.0
      ],
      "params": {
        "action": "Seize Delay Release",
        "distribution": "Exponential",
        "dist_params": {
          "rate": 0.5
        },
        "priority": 0,
        "quantity": 1,
        "resource_name": "Clerk",
        "time_unit": "minutes",
        "setup_unit": "minutes",
        "renege_time_unit": "minutes"
      }
    },
    {
      "name": "Consult",
      "description": "Consultation; the distribution is fitted from the visit log",
      "type": "PROCESS",
      "position": [
        440.0,
        200.0
      ],
      "layout_position": [
        14.0,
        3.0
      ],
      "params": {
        "action": "Seize Delay Release",
        "distribution": "Exponential",
        "dist_params": {
          "rate": 0.1111111111111111
        },
        "priority": 0,
        "quantity": 1,
        "resource_name": "Doctor",
        "time_unit": "minutes",
        "setup_unit": "minutes",
        "renege_time_unit": "minutes"
      }
    },
    {
      "name": "time_in_system",
      "description": "Time in system per patient",
      "type": "RECORD",
      "position": [
        660.0,
        200.0
      ],
      "params": {
        "stat_name": "time_in_system",
        "kind": "tally",
        "expr": "now - entity.creation_time"
      }
    },
    {
      "name": "leave",
      "description": "Patient leaves",
      "type": "DISPOSE",
      "position": [
        880.0,
        200.0
      ],
      "params": {
        "distribution": "Constant",
        "dist_params": {
          "value": 0.0
        },
        "time_unit": "minutes"
      }
    }
  ],
