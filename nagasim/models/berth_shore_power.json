        }
      ],
      "scoped": {
        "flows": {
          "Nrg shore": {},
          "Nrg auxiliary": {
            "price": {"$arg": "aux_fuel_price_per_kwh"},
            "emission_factor": {"$arg": "aux_emission_factor"}
          }
        }
      },
      "blocks": [
        {
          "name": "in",
          "type": "SUB_ENTRY",
          "description": "Ship arrives at the berth",
          "position": [0.0, 0.0]
        },
        {
          "name": "read",
          "type": "ASSIGN",
          "description": "Read the call",
          "position": [150.0, 0.0],
          "params": {
            "assignments": [
              {"target": "entity.nrg_hotel_in", "expr": {"$arg": "hotel_load"}},
              {"target": "entity.nrg_reefers_in", "expr": {"$arg": "reefer_count"}},
              {"target": "entity.nrg_ready_in", "expr": {"$arg": "ready"}},
              {"target": "entity.nrg_dwell", "expr": {"$arg": "dwell"}},
              {
                "target": "entity.nrg_berth_kw",
                "expr": "entity.nrg_hotel_in + entity.nrg_reefers_in * reefer_kw"
              },
              {
                "target": "entity.nrg_shore_kw",
                "expr": "IF(entity.nrg_ready_in > 0 and entity.nrg_dwell > connect_h + disconnect_h, entity.nrg_berth_kw, 0)"
              },
              {
                "target": "entity.nrg_t1",
                "expr": "IF(entity.nrg_ready_in > 0 and entity.nrg_dwell > connect_h + disconnect_h, connect_h, max(entity.nrg_dwell, 0))"
              },
              {
                "target": "entity.nrg_t2",
                "expr": "IF(entity.nrg_ready_in > 0 and entity.nrg_dwell > connect_h + disconnect_h, entity.nrg_dwell - connect_h - disconnect_h, 0)"
              },
              {
                "target": "entity.nrg_t3",
                "expr": "IF(entity.nrg_ready_in > 0 and entity.nrg_dwell > connect_h + disconnect_h, disconnect_h, 0)"
              },
              {"target": "$at_berth_kw", "expr": "VAR(\"$at_berth_kw\") + entity.nrg_berth_kw"}
            ]
          }
        },
        {
          "name": "connect",
          "type": "DELAY",
          "description": "Connect the cable",
          "position": [300.0, 0.0],
          "params": {"dist_params": {"value": "entity.nrg_t1"}, "time_unit": "hours"}
        },
        {
          "name": "plug_in",
          "type": "ASSIGN",
          "description": "Plug in",
          "position": [450.0, 0.0],
          "params": {
            "assignments": [
              {"target": "$connected_kw", "expr": "VAR(\"$connected_kw\") + entity.nrg_shore_kw"}
            ]
          }
        },
        {
          "name": "on_shore",
          "type": "DELAY",
          "description": "On shore power",
          "position": [600.0, 0.0],
          "params": {"dist_params": {"value": "entity.nrg_t2"}, "time_unit": "hours"}
        },
        {
          "name": "unplug",
          "type": "ASSIGN",
          "description": "Unplug",
          "position": [750.0, 0.0],
          "params": {
            "assignments": [
              {"target": "$connected_kw", "expr": "VAR(\"$connected_kw\") - entity.nrg_shore_kw"}
            ]
          }
        },
        {
          "name": "disconnect",
          "type": "DELAY",
          "description": "Disconnect the cable",
          "position": [900.0, 0.0],
          "params": {"dist_params": {"value": "entity.nrg_t3"}, "time_unit": "hours"}
        },
        {
          "name": "leave",
          "type": "ASSIGN",
          "description": "Ship leaves the berth",
          "position": [1050.0, 0.0],
          "params": {
            "assignments": [
              {"target": "$at_berth_kw", "expr": "VAR(\"$at_berth_kw\") - entity.nrg_berth_kw"}
            ]
          }
        },
        {
          "name": "out",
          "type": "SUB_EXIT",
          "description": "Ship departs",
          "position": [1200.0, 0.0]
        }
      ],
      "links": [
        {"source": "in", "target": "read"},
        {"source": "read", "target": "connect"},
        {"source": "connect", "target": "plug_in"},
        {"source": "plug_in", "target": "on_shore"},
        {"source": "on_shore", "target": "unplug"},
        {"source": "unplug", "target": "disconnect"},
        {"source": "disconnect", "target": "leave"},
        {"source": "leave", "target": "out"}
      ],
      "annotations": []
    },
    "Grid connection": {
      "info": {
        "description": "The meter: whatever the site cannot cover itself is imported and priced on a tariff profile, whatever it cannot use or store is exported up to the export limit, and the rest is curtailed. Import beyond the import limit is recorded as unserved demand rather than silently supplied. Emissions follow a grid intensity profile, so a sustainability assessment is the same run. Place exactly one per site: it is the slack that closes the energy balance. No ports: this is a continuous asset. A demand charge on the peak import power is billed once at the end of the run.",
        "library": {"library": "energy", "asset": "grid_connection", "version": "1.5.0"},
        "parameters": [
          {
            "name": "import_profile",
            "type": "name",
            "default": "Nrg tariff",
            "unit": "",
            "label": "Import tariff",
            "help": "Import price by hour of the day, EUR/kWh. A flat tariff is a one-value profile.",
            "group": "Prices",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": "timeseries_input"
          },
          {
            "name": "export_price",
            "type": "number",
            "default": 0.05,
            "unit": "EUR/kWh",
            "label": "Export price",
            "help": "Paid for every exported kWh: it enters Total Cost as a negative cost.",
            "group": "Prices",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
