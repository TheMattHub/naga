  "flows": [
    {
      "name": "Nrg shore",
      "description": "Shore power drawn by the ships at the berth, kW, capped at the connection limit; tagged demand so the grid connection serves it.",
      "rate": "min(VAR(\"$connected_kw\"), connection_kw)",
      "tag": "demand"
    },
    {
      "name": "Nrg auxiliary",
      "description": "The at-berth load the shore link does not carry, kW, from the ships' own engines.",
      "rate": "VAR(\"$at_berth_kw\") - min(VAR(\"$connected_kw\"), connection_kw)",
      "price": 0.2,
      "emission_factor": 0.69
    },
    {
      "name": "Nrg import",
      "description": "Whatever the site could not cover itself, up to the connection limit, kW.",
      "rate": "min(max(FLOWSUM(\"demand\") + FLOWSUM(\"storage_in\") - FLOWSUM(\"generation\") - FLOWSUM(\"storage_out\") - FLOWSUM(\"dispatchable\"), 0), import_limit_kw)",
      "price": "TS(import_profile)",
      "emission_factor": "TS(intensity_profile)",
      "tag": "import",
      "peak_price": 0.0
    },
    {
      "name": "Nrg unserved",
      "description": "Demand the connection limit could not deliver, kW.",
      "rate": "max(FLOWSUM(\"demand\") + FLOWSUM(\"storage_in\") - FLOWSUM(\"generation\") - FLOWSUM(\"storage_out\") - FLOWSUM(\"dispatchable\") - FLOW(\"$Nrg import\"), 0)",
      "tag": "unserved"
    },
    {
      "name": "Nrg export",
      "description": "Surplus sold to the grid, up to the export limit, kW. A negative price is revenue.",
      "rate": "min(max(FLOWSUM(\"generation\") + FLOWSUM(\"storage_out\") + FLOWSUM(\"dispatchable\") - FLOWSUM(\"demand\") - FLOWSUM(\"storage_in\"), 0), export_limit_kw)",
      "price": "-export_price",
      "tag": "export"
    },
    {
      "name": "Nrg curtailed",
      "description": "Generation that was neither used, stored nor exported, kW.",
      "rate": "max(FLOWSUM(\"generation\") + FLOWSUM(\"storage_out\") + FLOWSUM(\"dispatchable\") - FLOWSUM(\"demand\") - FLOWSUM(\"storage_in\") - FLOW(\"$Nrg export\"), 0)",
      "tag": "curtailed"
    }
  ],
