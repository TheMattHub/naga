      "parameters": [
        {
          "name": "connection_kw",
          "default": 2000.0,
          "type": "number",
          "description": "The most the shore link delivers to all ships at the berth together."
        },
        {
          "name": "connect_h",
          "default": 0.5,
          "type": "number",
          "description": "Time from arrival to plug-in; the ship runs on auxiliaries meanwhile."
        },
        {
          "name": "disconnect_h",
          "default": 0.5,
          "type": "number",
          "description": "Time before departure the ship unplugs and runs on auxiliaries again."
        },
        {
          "name": "reefer_kw",
          "default": 4.4,
          "type": "number",
          "description": "Electrical load of one refrigerated container."
        },
        {
          "name": "aux_fuel_price_per_kwh",
          "default": 0.2,
          "type": "number",
          "description": "Cost of one kWh of electricity from the ship's auxiliaries; an estimate for marine gas oil, replace it with your fuel price."
        },
        {
          "name": "aux_emission_factor",
          "default": 0.69,
          "type": "number",
          "description": "Impact per kWh from the auxiliaries; an estimate for marine gas oil."
        },
        {
          "name": "hotel_load",
          "default": "entity.hotel_kw",
          "type": "name",
          "description": "Expression for the ship's hotel load in kW."
        },
        {
          "name": "reefer_count",
          "default": "entity.reefers",
          "type": "name",
          "description": "Expression for the number of reefers aboard; give 0 when the call has none."
        },
        {
          "name": "ready",
          "default": "entity.shore_ready",
          "type": "name",
          "description": "Expression that is 1 for a ship able to take shore power and 0 for one that is not; give 1 when every ship is ready."
        },
        {
          "name": "dwell",
          "default": "entity.dwell_h",
          "type": "name",
