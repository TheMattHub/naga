  "info": {
    "title": "Berth: shore power",
    "category": "Energy",
    "description": "A two-berth quay over four weeks of ship calls, with each ship's hotel load and reefers met by its own engines or, when the ship is ready and the call long enough, by a shore connection priced on a tariff and a grid carbon intensity. The question it answers: how much CO2 and energy cost does shore power save, how large must the connection be, and does the capital pay back? Read the flow summary (shore and auxiliary kWh, peak kW), the cost summary, and the investment case across scenarios. Illustrative figures."
  },
  "data_sources": [
    {
      "name": "berth calls",
      "kind": "csv",
      "location": "data/berth_calls.csv",
      "description": "One row per ship call: type, hotel load, reefers, dwell"
    }
  ],
  "data_bindings": [
    {
      "name": "call book",
      "source": "berth calls",
      "transform": "orders",
