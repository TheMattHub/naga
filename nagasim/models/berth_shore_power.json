  "submodels": {
    "Shore power": {
      "info": {
        "description": "A ship at a berth. A call enters by \"in\" with its hotel load (kW), reefer count, a ready flag and its dwell in hours, and leaves by \"out\" after that dwell. While it is at the berth its load, hotel plus reefers, counts as at-berth demand. A ready ship whose dwell is longer than connect plus disconnect time plugs in after the connect time and draws shore power until the disconnect starts; any other ship burns auxiliary power for its whole stay. Two flows show the split: \"Nrg shore\" is the shore part, tagged demand and capped at the connection limit across all ships at once, so the grid connection prices it; \"Nrg auxiliary\" is the rest, from the ships' own engines, priced and counted for emissions here. A negative dwell counts as 0, so a call never waits a negative time. The four ship attributes are expressions on the entity, so a model that names them differently (or has no reefers) passes its own.",
        "library": {"library": "energy", "asset": "shore_power", "version": "1.5.0"},
        "parameters": [
          {
            "name": "connection_kw",
            "type": "number",
            "default": 2000.0,
            "unit": "kW",
            "label": "Shore connection limit",
            "help": "The most the shore link delivers to all ships at the berth together.",
            "group": "Shore link",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "connect_h",
            "type": "number",
            "default": 0.5,
            "unit": "hours",
            "label": "Connect time",
            "help": "Time from arrival to plug-in; the ship runs on auxiliaries meanwhile.",
            "group": "Shore link",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "disconnect_h",
            "type": "number",
            "default": 0.5,
            "unit": "hours",
            "label": "Disconnect time",
            "help": "Time before departure the ship unplugs and runs on auxiliaries again.",
            "group": "Shore link",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "reefer_kw",
            "type": "number",
            "default": 4.4,
            "unit": "kW",
            "label": "Load per reefer",
            "help": "Electrical load of one refrigerated container.",
            "group": "Ship",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "aux_fuel_price_per_kwh",
            "type": "number",
            "default": 0.2,
            "unit": "EUR/kWh",
            "label": "Auxiliary energy price",
            "help": "Cost of one kWh of electricity from the ship's auxiliaries; an estimate for marine gas oil, replace it with your fuel price.",
            "group": "Cost",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "aux_emission_factor",
            "type": "number",
            "default": 0.69,
            "unit": "kg CO2e/kWh",
            "label": "Auxiliary emission factor",
            "help": "Impact per kWh from the auxiliaries; an estimate for marine gas oil.",
            "group": "Emissions",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "hotel_load",
            "type": "name",
            "default": "entity.hotel_kw",
            "unit": "",
            "label": "Hotel load",
            "help": "Expression for the ship's hotel load in kW.",
            "group": "Ship attributes",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "reefer_count",
            "type": "name",
            "default": "entity.reefers",
            "unit": "",
            "label": "Reefers",
            "help": "Expression for the number of reefers aboard; give 0 when the call has none.",
            "group": "Ship attributes",
            "min": null,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "ready",
            "type": "name",
            "default": "entity.shore_ready",
            "unit": "",
            "label": "Shore-ready flag",
            "help": "Expression that is 1 for a ship able to take shore power and 0 for one that is not; give 1 when every ship is ready.",
            "group": "Ship attributes",
            "min": null,
            "max": null,
            "choices": [],
