{
  "$schema": "https://thematthub.github.io/naga/schema/model-v29.json",
  "schema_version": 29,
  "blocks": [
    {
      "name": "arrive",
      "type": "CREATE",
      "description": "Kits arrive, one every 50 s on average",
      "position": [100.0, 200.0],
      "params": {"distribution": "Exponential", "dist_params": {"rate": 0.02}}
    },
    {
      "name": "prepare",
      "type": "PROCESS",
      "description": "Prepare the kit",
      "position": [320.0, 200.0],
      "params": {"dist_params": {"value": "TRIA(20, 25, 32)"}, "resource_name": "Press"}
    },
    {
      "name": "assemble",
      "type": "MOTION",
      "description": "Assemble: by hand as saved, by a robot arm in the scenario \"Robot cell\"",
      "position": [540.0, 200.0],
      "params": {
        "profile": "Operator",
        "segments": [
          {"kind": "move", "distance_m": 3.0},
          {"kind": "pick", "time": "2.0"},
          {"kind": "move", "distance_m": 3.0, "payload_kg": 2.0},
          {"kind": "place", "time": "1.0"},
          {"kind": "process", "time": "TRIA(24, 30, 40)"}
        ],
        "resource_name": "Assembly"
      }
    },
    {
      "name": "test",
      "type": "PROCESS",
      "description": "Test the assembly",
      "position": [760.0, 200.0],
      "params": {"dist_params": {"value": "15"}, "resource_name": "Tester"}
    },
    {
      "name": "ship",
      "type": "DISPOSE",
      "description": "Good parts leave",
      "position": [980.0, 200.0]
    }
  ],
  "links": [
    {"source": "arrive", "target": "prepare"},
    {"source": "prepare", "target": "assemble"},
    {"source": "assemble", "target": "test"},
    {"source": "test", "target": "ship"}
  ],
  "scenarios": [
    {
      "name": "Robot cell",
      "overrides": [
        {"path": "blocks.assemble.params.profile", "value": "Robot arm"},
        {
          "path": "blocks.assemble.params.segments",
          "value": [
            {"kind": "move", "distance_m": 0.8},
            {"kind": "pick", "time": "0.5"},
            {"kind": "move", "distance_m": 0.8, "payload_kg": 2.0},
            {"kind": "place", "time": "0.5"},
            {"kind": "process", "time": "TRIA(16, 20, 26)"}
          ]
        },
        {"path": "resources.Assembly.cost_busy", "value": 2.0},
        {"path": "resources.Assembly.cost_idle", "value": 2.0},
        {"path": "fixed_costs.Robot cell.amount", "value": 85000}
      ]
    }
  ],
  "resources": [
    {"name": "Press", "capacity": 1, "discipline": "FIFO"},
    {"name": "Assembly", "capacity": 1, "discipline": "FIFO", "cost_busy": 30.0, "cost_idle": 30.0},
    {"name": "Tester", "capacity": 1, "discipline": "FIFO"}
  ],
  "entities": [{"name": "DEFAULT", "shape": "circle", "color": "BLACK"}],
  "fixed_costs": [{"name": "Robot cell", "category": "Capital", "amount": 0, "capex": true}],
  "motion_profiles": [
    {
      "name": "Operator",
      "kind": "human",
      "speed": 1.2,
      "accel": 0.8,
      "payload_max": 15.0,
      "payload_derate": 0.7
    },
    {
      "name": "Robot arm",
      "kind": "robot",
      "speed": 2.0,
      "accel": 6.0,
      "payload_max": 20.0,
      "payload_derate": 0.7
    }
  ],
  "info": {
    "title": "Robot cell against manual assembly",
    "category": "Manufacturing",
    "description": "A short line whose assembly station is manual as saved (a MOTION cycle with a human profile, an operator at 30 per hour) and a robot cell in the scenario \"Robot cell\" (a robot profile and cycle, 2 per hour of maintenance, 85 000 of capex). Its investment section compares the scenario with the saved model: `naga invest` gives payback, NPV and ROI, and `naga scenarios` the throughput and cost of each. Illustrative figures."
  },
  "simulation": {"time_limit": 30600, "warmup": 1800, "replications": 5, "time_unit": "seconds"},
  "investment": {
    "baseline": "",
    "horizon_years": 5,
    "discount_rate": 0.08,
    "operating_hours_per_year": 2000,
    "margin_per_part": 0.0,
    "throughput": ""
  },
  "outputs": {}
}
