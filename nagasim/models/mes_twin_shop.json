{
  "$schema": "https://thematthub.github.io/naga/schema/model-v29.json",
  "schema_version": 29,
  "blocks": [
    {
      "name": "release_orders",
      "type": "CREATE",
      "description": "Releases every work order at its own release time",
      "position": [140.0, 300.0],
      "params": {"e_type": "WIDGET", "arrival_mode": "Orders"}
    },
    {
      "name": "dispatch",
      "type": "ROUTE",
      "description": "Send each job to the first station of its routing",
      "position": [380.0, 300.0],
      "params": {"dist_params": {"value": 2.0}}
    },
    {
      "name": "cutting",
      "type": "SUBMODEL",
      "description": "Cutting cell (one saw)",
      "position": [640.0, 140.0],
      "layout_position": [2.0, 1.0],
      "params": {
        "definition": "Routed station",
        "arguments": {
          "station_name": "Cutting",
          "time_source": "table",
          "machines": 1,
          "transfer_time": 2.0,
          "cost_rate": 0.6
        }
      }
    },
    {
      "name": "drilling",
      "type": "SUBMODEL",
      "description": "Drilling cell (two drills)",
      "position": [640.0, 300.0],
      "layout_position": [2.0, 9.0],
      "params": {
        "definition": "Routed station",
        "arguments": {
          "station_name": "Drilling",
          "time_source": "table",
          "machines": 2,
          "transfer_time": 2.0,
          "cost_rate": 0.6
        }
      }
    },
    {
      "name": "assembly",
      "type": "SUBMODEL",
      "description": "Assembly cell (one bench) -- the shop's bottleneck",
      "position": [640.0, 460.0],
      "layout_position": [2.0, 17.0],
      "params": {
        "definition": "Routed station",
        "arguments": {
          "station_name": "Assembly",
          "time_source": "table",
          "machines": 1,
          "transfer_time": 2.0,
          "cost_rate": 0.6
        }
      }
    },
    {
      "name": "record_exit",
      "type": "RECORD",
      "description": "Tally shop-floor time for a finished job",
      "position": [940.0, 300.0],
      "params": {
        "stat_name": "shop_floor_time",
        "kind": "tally",
        "expr": "TNOW - entity.creation_time"
      }
    },
    {
      "name": "ship",
      "type": "DISPOSE",
      "description": "Finished jobs leave the shop",
      "position": [1140.0, 300.0]
    }
  ],
  "links": [
    {"source": "release_orders", "target": "dispatch"},
    {"source": "dispatch", "target": "record_exit"},
    {"source": "cutting", "target": "record_exit", "source_port": "out"},
    {"source": "drilling", "target": "record_exit", "source_port": "out"},
    {"source": "assembly", "target": "record_exit", "source_port": "out"},
    {"source": "record_exit", "target": "ship"}
  ],
