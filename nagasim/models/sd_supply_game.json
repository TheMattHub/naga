{
  "$schema": "https://thematthub.github.io/naga/schema/model-v29.json",
  "schema_version": 29,
  "blocks": [
    {
      "name": "weekly_review",
      "type": "CREATE",
      "description": "A review token every week: drives the player's order-rate decision, not a physical flow",
      "position": [0.0, 260.0],
      "params": {"e_type": "ORDER_REVIEW"}
    },
    {
      "name": "order_decision",
      "type": "DECIDE",
      "description": "Weekly order-rate policy 'order'; falls back to the low order rate with no controller attached",
      "position": [220.0, 260.0],
      "params": {
        "mode": "Policy",
        "policy": "order",
        "observation": ["LEVEL(\"Inventory\")", "LEVEL(\"Supply Line\")"]
      }
    },
    {
      "name": "assign_low",
      "type": "ASSIGN",
      "description": "Option 0: order low (8/week)",
      "position": [440.0, 140.0],
      "params": {"assignments": [{"target": "orders", "expr": "8"}]}
    },
    {
      "name": "assign_medium",
      "type": "ASSIGN",
      "description": "Option 1: order medium (14/week)",
      "position": [440.0, 260.0],
      "params": {"assignments": [{"target": "orders", "expr": "14"}]}
    },
    {
      "name": "assign_high",
      "type": "ASSIGN",
      "description": "Option 2: order high (22/week)",
      "position": [440.0, 380.0],
      "params": {"assignments": [{"target": "orders", "expr": "22"}]}
    },
    {
      "name": "leave_review",
      "type": "DISPOSE",
      "description": "The review token has done its job",
      "position": [660.0, 260.0]
    }
  ],
  "links": [
    {"source": "weekly_review", "target": "order_decision"},
    {"source": "order_decision", "target": "assign_low"},
    {"source": "order_decision", "target": "assign_medium"},
    {"source": "order_decision", "target": "assign_high"},
    {"source": "assign_low", "target": "leave_review"},
    {"source": "assign_medium", "target": "leave_review"},
    {"source": "assign_high", "target": "leave_review"}
  ],
  "variables": [{"name": "orders", "initial": 10}],
  "entities": [{"name": "ORDER_REVIEW", "shape": "circle", "color": "blue"}],
  "levels": [
    {"name": "Inventory", "initial": 100.0, "min": null},
    {"name": "Supply Line", "initial": 30.0, "min": 0.0},
    {"name": "Total Cost", "initial": 0.0, "min": 0.0}
  ],
  "flows": [
    {
      "name": "place_order",
      "description": "The player's order rate joins the pipeline",
      "rate": "orders",
      "to": "Supply Line"
    },
    {
      "name": "receive_shipment",
      "description": "Orders arrive after a 3rd-order (S-shaped) shipping delay",
      "rate": "DELAY3(orders, AUX(\"lead_time\"), 0)",
      "from": "Supply Line",
      "to": "Inventory"
    },
    {
      "name": "ship_to_customer",
      "description": "Customer demand is always shipped; a negative Inventory IS the backlog",
      "rate": "AUX(\"customer_demand\")",
      "from": "Inventory"
    },
    {
      "name": "accrue_cost",
      "description": "Holding cost on positive Inventory, backorder cost on negative Inventory",
      "rate": "AUX(\"holding_unit_cost\") * max(LEVEL(\"Inventory\"), 0) + AUX(\"backorder_unit_cost\") * max(-LEVEL(\"Inventory\"), 0)",
      "to": "Total Cost"
    }
  ],
  "auxiliaries": [
    {"name": "customer_demand", "expr": "10 + STEP(6, 5)"},
    {"name": "lead_time", "expr": "3"},
    {"name": "holding_unit_cost", "expr": "0.5"},
    {"name": "backorder_unit_cost", "expr": "1.5"},
    {"name": "service_level", "expr": "max(0, min(1, 1 + LEVEL(\"Inventory\") / 40))"}
  ],
  "info": {
    "title": "Supply line: order-rate management game",
    "category": "Games",
    "description": "A one-echelon, beer-game-style supply line: Inventory is replenished from a Supply Line pipeline through a 3rd-order shipping delay (DELAY3); customer demand steps up in week 5. A negative Inventory level IS the backlog, so one stock covers both. Every week a Policy-mode DECIDE ('order') asks the player to set the order rate low/medium/high, with a finer control beside it; Total Cost accumulates holding and backorder cost. In the results, read on-hand inventory against backlog, total cost and the service level.",
    "author": "Naga example"
  },
  "simulation": {
    "time_limit": 40.0,
    "warmup": 0.0,
    "replications": 1,
    "time_unit": "weeks",
    "sd": {"dt": 0.1, "method": "rk4", "time_unit": "weeks"}
  },
  "outputs": {},
  "dashboard": {
    "widgets": [
      {
        "name": "inventory_backlog",
        "kind": "line",
        "title": "On-hand inventory vs backlog",
        "series": [
          {"label": "On-hand", "expr": "max(LEVEL(\"Inventory\"), 0)"},
          {"label": "Backlog", "expr": "max(-LEVEL(\"Inventory\"), 0)"}
        ]
      },
      {"name": "total_cost", "kind": "kpi", "title": "Total cost", "expr": "LEVEL(\"Total Cost\")"},
      {
        "name": "service_level_gauge",
        "kind": "gauge",
        "title": "Service level",
        "expr": "AUX(\"service_level\")",
        "min": 0,
        "max": 1,
        "thresholds": [0.7, 0.9]
      }
    ],
    "controls": [
      {
        "name": "orders_slider",
        "kind": "slider",
        "title": "Fine-tune the order rate",
        "target": {"variable": "orders"},
        "min": 0,
        "max": 30,
        "step": 1
      },
      {
        "name": "order_policy",
        "kind": "decision",
        "title": "Weekly order rate (reviewed every week)",
        "policy": "order",
        "options": ["Low (8/week)", "Medium (14/week)", "High (22/week)"]
      }
    ]
  }
}
