      "expr": "10"
    },
    {
      "name": "SD lead time",
      "expr": "5"
    }
  ],
  "submodels": {
    "Inventory with lead time": {
      "info": {
        "description": "A stock replenished through a lead time: orders are placed at the (constant) demand rate, arrive DELAY3(demand_rate, lead_time) later (a third-order material delay -- an S-shaped, not instant, response), and are consumed at the demand rate. \"SD On Order\" is the pipeline itself (orders placed but not yet arrived); by Little's law it settles at demand_rate x lead_time. Needs simulation.sd.",
        "library": {
          "library": "sd",
          "asset": "inventory_delay3",
          "version": "1.1.0"
        },
        "parameters": [
          {
            "name": "demand_rate",
            "type": "number",
            "default": 10.0,
            "unit": "",
            "label": "Demand Rate",
            "help": "Constant consumption and ordering rate.",
            "group": "Parameters",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "lead_time",
            "type": "number",
            "default": 5.0,
            "unit": "",
            "label": "Lead Time",
            "help": "Time from placing an order to receiving it.",
            "group": "Parameters",
            "min": 0.0001,
            "max": null,
            "choices": [],
            "refers_to": ""
          },
          {
            "name": "initial_stock",
            "type": "number",
            "default": 150.0,
            "unit": "",
            "label": "Initial Stock",
            "help": "Starting inventory; comfortably above demand_rate x lead_time so the third-order delay's slower ramp-up does not empty it before arrivals catch up.",
            "group": "Parameters",
            "min": 0.0,
            "max": null,
            "choices": [],
            "refers_to": ""
          }
        ],
        "owns": {
          "levels": [
            "SD Inventory",
            "SD On Order"
          ],
          "auxiliaries": [
            "SD demand rate",
            "SD lead time"
          ],
          "flows": [
            "SD place order",
            "SD arrivals",
            "SD consumption"
          ]
        }
      },
      "parameters": [
        {
          "name": "demand_rate",
          "default": 10.0,
          "type": "number",
          "description": "Constant consumption and ordering rate."
        },
        {
          "name": "lead_time",
          "default": 5.0,
