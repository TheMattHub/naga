  "agent_types": [
    {
      "name": "Patient",
      "description": "An ED patient's clinical trajectory while it waits: it may worsen before a doctor is free, which is what the doctor's queue ranking (highest entity.agent.acuity first) then reacts to.",
      "attributes": [
        {
          "name": "acuity",
          "init": "1"
        }
      ],
      "states": [
        {
          "name": "Stable",
          "color": "GREEN"
        },
        {
          "name": "Deteriorating",
          "color": "ORANGE"
        },
        {
          "name": "Critical",
          "color": "RED"
        },
        {
          "name": "Discharged",
          "color": "GRAY"
        }
      ],
      "transitions": [
        {
          "from": "Stable",
          "to": "Deteriorating",
          "rate": "1.5",
          "actions": [
            {
              "target": "self.acuity",
              "expr": "2"
            }
          ],
          "rate_unit": "hours"
        },
        {
          "from": "Deteriorating",
          "to": "Critical",
          "rate": "1.5",
          "actions": [
            {
              "target": "self.acuity",
              "expr": "3"
            }
          ],
          "rate_unit": "hours"
        },
        {
          "from": "Stable",
          "to": "Discharged",
          "message": "treated"
        },
        {
          "from": "Deteriorating",
          "to": "Discharged",
          "message": "treated"
        },
        {
          "from": "Critical",
          "to": "Discharged",
          "message": "treated"
        }
      ],
      "initial_state": "Stable",
      "speed_unit": "m/h"
    }
  ],
