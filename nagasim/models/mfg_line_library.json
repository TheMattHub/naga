    "WIP cap (CONWIP / kanban loop)": {
      "info": {
        "description": "Caps the work in progress of a region. Wire the line's entry through 'in' -> 'out' and its exit through 'return' -> 'done': a job takes one of this instance's tokens on the way in and gives it back on the way out, so at most 'cap' jobs are ever inside.",
        "library": {
          "library": "manufacturing",
          "asset": "wip_cap",
          "version": "1.0.0"
        },
        "parameters": [
          {
            "name": "cap",
            "type": "int",
            "default": 10,
            "unit": "",
            "label": "WIP cap (tokens)",
            "help": "Largest number of jobs allowed inside the region at once.",
            "group": "Control",
            "min": 1,
            "max": 10000,
            "choices": []
          }
        ]
      },
      "parameters": [
        {
          "name": "cap",
          "default": 10,
          "description": "Largest number of jobs allowed inside the region at once."
        }
      ],
      "scoped": {
        "resources": {
          "Mfg WIP tokens": {
            "capacity": "cap"
          }
        }
      },
      "blocks": [
        {
          "name": "in",
          "type": "SUB_ENTRY",
          "description": "Jobs entering the region",
          "position": [
            0.0,
            0.0
          ]
        },
        {
          "name": "take_token",
          "type": "SEIZE",
          "description": "Take a WIP token",
          "position": [
            200.0,
            0.0
          ],
          "params": {
            "time_unit": "minutes",
            "resource_name": "$Mfg WIP tokens"
          }
        },
        {
          "name": "out",
          "type": "SUB_EXIT",
          "description": "Jobs admitted",
          "position": [
            400.0,
            0.0
          ]
        },
        {
          "name": "return",
          "type": "SUB_ENTRY",
          "description": "Jobs leaving the region",
          "position": [
            0.0,
            150.0
          ],
          "params": {
            "port": "return"
          }
        },
        {
          "name": "give_token",
          "type": "RELEASE",
          "description": "Give the token back",
          "position": [
            200.0,
            150.0
          ],
          "params": {
            "time_unit": "minutes",
            "resource_name": "$Mfg WIP tokens"
          }
        },
        {
          "name": "done",
