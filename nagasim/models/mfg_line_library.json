    "Batch oven": {
      "info": {
        "description": "Collects 4 jobs, processes them together for one bake time, then splits them again. The batch size is fixed in the definition: open the instance and edit the 'collect' block to change it.",
        "library": {
          "library": "manufacturing",
          "asset": "batch_oven",
          "version": "1.0.0"
        },
        "parameters": [
          {
            "name": "bake_time",
            "type": "time",
            "default": 30.0,
            "unit": "minutes",
            "label": "Bake time",
            "help": "Time one whole batch spends in the oven, in minutes.",
            "group": "Timing",
            "min": 0.0,
            "max": null,
            "choices": []
          },
          {
            "name": "time_distribution",
            "type": "choice",
            "default": 2,
            "unit": "",
            "label": "Time distribution (1 fixed, 2 exponential, 3 triangular +/-30%)",
            "help": "Shape of the process time around its mean: 1 = exactly the mean, 2 = exponential, 3 = triangular between 70% and 130% of it.",
            "group": "Timing",
            "min": null,
            "max": null,
            "choices": [
              1,
              2,
              3
            ]
          },
          {
            "name": "ovens",
            "type": "int",
            "default": 1,
            "unit": "",
            "label": "Ovens",
            "help": "Parallel units in this station (the per-instance resource's capacity).",
            "group": "Resource",
            "min": 1,
            "max": 200,
            "choices": []
          },
          {
            "name": "cost_rate",
            "type": "number",
            "default": 0.0,
            "unit": "currency per minute",
            "label": "Busy cost rate",
            "help": "Cost charged per minute while the station is busy; 0 leaves it out of the costing.",
            "group": "Cost",
            "min": 0.0,
            "max": null,
            "choices": []
          }
        ]
      },
      "parameters": [
        {
          "name": "bake_time",
          "default": 30.0,
          "description": "Time one whole batch spends in the oven, in minutes."
        },
        {
          "name": "time_distribution",
          "default": 2,
          "description": "Shape of the process time around its mean: 1 = exactly the mean, 2 = exponential, 3 = triangular between 70% and 130% of it."
        },
        {
          "name": "ovens",
          "default": 1,
          "description": "Parallel units in this station (the per-instance resource's capacity)."
        },
        {
          "name": "cost_rate",
          "default": 0.0,
          "description": "Cost charged per minute while the station is busy; 0 leaves it out of the costing."
        }
      ],
      "scoped": {
        "resources": {
          "Mfg Oven": {
            "capacity": "ovens",
            "cost_busy": "cost_rate"
          }
        }
      },
      "blocks": [
        {
          "name": "in",
          "type": "SUB_ENTRY",
          "description": "Jobs arrive",
          "position": [
            0.0,
            0.0
          ]
        },
        {
          "name": "collect",
          "type": "BATCH",
          "description": "Collect 4 jobs",
          "position": [
            200.0,
            0.0
          ],
          "params": {
            "batch_size": 4,
            "batched_entity_type": "Mfg Load"
          }
        },
        {
          "name": "bake",
          "type": "PROCESS",
          "description": "Oven",
          "position": [
            400.0,
            0.0
          ],
          "params": {
            "dist_params": {
              "value": "bake_time if time_distribution == 1 else (EXPO(bake_time) if time_distribution == 2 else TRIA(0.7 * bake_time, bake_time, 1.3 * bake_time))"
            },
            "time_unit": "minutes",
            "resource_name": "$Mfg Oven"
          }
        },
        {
          "name": "unload",
          "type": "SEPARATE",
          "description": "Split the load",
          "position": [
            600.0,
            0.0
          ]
        },
        {
          "name": "out",
          "type": "SUB_EXIT",
          "description": "Jobs leave",
          "position": [
            800.0,
            0.0
          ]
        }
      ],
