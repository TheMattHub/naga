    def add_level(
        self,
        *,
        diagram: dict[str, Any] = ...,
        name: str = ...,
        dims: list[Any] = ...,
        elements: dict[str, Any] = ...,
        description: str = ...,
        unit: str = ...,
        capacity: float | None = ...,
        min: float | None = ...,
        initial: float | str = ...,
        max_inflow: float | None = ...,
        max_outflow: float | None = ...,
        rate_time_unit: Literal['base', 'milliseconds', 'seconds', 'minutes', 'hours', 'days', 'weeks', 'months', 'years'] = ...,
        thresholds: list[Any] = ...,
        components: list[Any] = ...,
        blend_tolerance: float = ...,
        conveyor: dict[str, Any] = ...,
    ) -> Any:
        """Add one entry to `levels` and return its name. Continuous quantities with bounds (battery energy, tank volume, an inventory position), read by LEVEL("name").

        diagram: Position in the stock-and-flow view; ignored by the engine.
        name
        dims: Subscripts this record runs over: it is flattened into one record per element, named "Name[north]" ("Name[north,young]" for two). Inside, "x[dim]" in a LEVEL/FLOW/AUX/DELAY name reads the same element, and SUM(x)/MEAN(x) aggregate over "x[*]".
        elements: Per-element equations: {"north": "2", "a,x": "3"} replaces the record's first expression (a level's initial, a flow's rate, an auxiliary's expr, a delay's input) for those elements; the shared one covers the rest. Keys join one element per dim with a comma.
        description
        unit: Label only, e.g. kWh or tonnes.
        capacity: Upper bound; omit for an unbounded accumulator.
        min: Lower bound; null for a stock unbounded below .
        initial: Value at t=0, inside [min, capacity]; or an expression, evaluated once in dependency order .
        max_inflow: Largest total rate that may be ADDED to the level (a charge-power limit).
        max_outflow: Largest total rate that may be REMOVED from it (a discharge-power limit).
        rate_time_unit: Unit the two power limits are per.
        thresholds: Level values that fire discrete logic when crossed.
        components: Named components the level's content is tracked in: a gas holder's ch4. Each inflow carries a share, each outflow draws at the level's own blend, and the component is conserved exactly. Read by FRACTION(name, component).
        blend_tolerance: How far the fraction may drift from the value the outflows are drawing at before the engine re-evaluates. The crossing instant is solved in closed form; the component is conserved exactly whatever this is set to.
        conveyor: Makes the stock a Stella conveyor: material rides round(transit_time/dt) slats of the SD grid (euler only), leaves as the one primary outflow (rate "") and may leak on the way through "leak" flows. The stock is the sum of the slats and changes only at grid points.
        """

    def add_flow(
        self,
        *,
        diagram: dict[str, Any] = ...,
        name: str = ...,
        dims: list[Any] = ...,
        elements: dict[str, Any] = ...,
        description: str = ...,
        to: str | None = ...,
        rate: str | float = ...,
        biflow: bool = ...,
        rate_time_unit: Literal['base', 'milliseconds', 'seconds', 'minutes', 'hours', 'days', 'weeks', 'months', 'years'] = ...,
        efficiency: float = ...,
        price: str | float = ...,
        emission_factor: str | float = ...,
        tag: str = ...,
        priority: float = ...,
        peak_price: float = ...,
        min_rate: float = ...,
        components: dict[str, Any] = ...,
        leak: dict[str, Any] = ...,
        thresholds: list[Any] = ...,
        **fields: Any,
    ) -> Any:
        """Add one entry to `flows` and return its name. Rate-based transfers between levels, re-evaluated at events.

        diagram: Position in the stock-and-flow view; ignored by the engine.
        name
        dims: Subscripts this record runs over: it is flattened into one record per element, named "Name[north]" ("Name[north,young]" for two). Inside, "x[dim]" in a LEVEL/FLOW/AUX/DELAY name reads the same element, and SUM(x)/MEAN(x) aggregate over "x[*]".
        elements: Per-element equations: {"north": "2", "a,x": "3"} replaces the record's first expression (a level's initial, a flow's rate, an auxiliary's expr, a delay's input) for those elements; the shared one covers the rest. Keys join one element per dim with a comma.
        description
        from: Level drawn from; omit for a source outside the model. A level at its min passes on no more than flows into it, so a rate needs no guard such as IF(LEVEL("x") > 0, r, 0); on a step grid that guard reads the level a step late.
        to: Level fed; omit for a sink outside the model.
        rate: Quantity per time unit: an expression over variables, TS(), TABLE(), LEVEL() and FLOW(). A negative value is clamped to 0 -- declare the reverse flow instead, or set "biflow".
        biflow: Bi-directional: a negative rate runs the flow backwards instead of being clamped to 0. Both ends must be outside the model or levels with "min": null and no capacity or power limit.
        rate_time_unit: Unit the rate is per.
        efficiency: out = in * efficiency; the rest is a loss.
        price: Money per unit moved; integrated exactly into the flow's Cost and the model's Total Cost.
        emission_factor: Impact per unit moved (emissions, water, waste), integrated into Total Impact.
        tag: Bus tag: every flow carrying it is summed by FLOWSUM("tag"), so a site's generation or demand is one number however many assets contribute to it.
        priority: Merit order within a tag: FLOWSUM("tag", p) sums only the flows with a priority below p -- what the devices dispatched before this one actually took.
        peak_price: Demand charge: money per unit of the flow's Peak Rate, billed ONCE at the end of the run. A time-varying tariff is "price".
        min_rate: Minimum load: the flow runs at 0 or at least this rate, never in between. The gate is applied to the rate the expression ASKED for, before saturation, so it adds no event of its own and cannot chatter.
        components: Share of what this flow moves that is each component, a number or an expression. Omit a component to carry the SOURCE level's own blend.
        leak: A conveyor's leakage outflow; set "rate": "" and "from" the conveyor.
        thresholds: Realised-rate values that fire discrete logic when crossed : a signal, a variable, and a lump cost per crossing -- a generator's start cost. Rising crossings are counted as the flow's Starts.
        """

    def add_conversion(
        self,
        *,
        name: str = ...,
        description: str = ...,
        unit: str = ...,
        cohort_interval: float = ...,
        time_unit: Literal['base', 'milliseconds', 'seconds', 'minutes', 'hours', 'days', 'weeks', 'months', 'years'] = ...,
        substrates: list[Any] = ...,
    ) -> Any:
