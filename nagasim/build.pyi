        setup_key: str | dict[str, Any] = '',
        initial_key: str | dict[str, Any] = '',
        setup_cost: float | str | dict[str, Any] = '',
        setup_cost_category: str | dict[str, Any] = '',
        balk_if: str | dict[str, Any] = '',
        renege_after: float | str | dict[str, Any] = '',
