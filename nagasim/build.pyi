        release: float | str = ...,
        due: float | str | None = ...,
        time_unit: Literal['base', 'milliseconds', 'seconds', 'minutes', 'hours', 'days', 'weeks', 'months', 'years'] = ...,
        quantity: int = ...,
        entity_type: str = ...,
        sequence: str = ...,
        priority: float = ...,
        source: str = ...,
        attributes: dict[str, Any] = ...,
        plan: dict[str, Any] = ...,
    ) -> Any:
        """Add one entry to `orders` and return its id. Released jobs with a due date, emitted by a CREATE block in "Orders" arrival mode.

