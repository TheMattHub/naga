<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0">
  <header>
    <name>Two-region population</name>
    <vendor>Naga</vendor>
    <product version="1.0">Naga test fixture (DEVLOG #127)</product>
  </header>
  <sim_specs method="Euler" time_units="days">
    <start>0</start>
    <stop>20</stop>
    <dt>0.25</dt>
  </sim_specs>
  <dimensions>
    <dim name="Region">
      <elem name="north"/>
      <elem name="south"/>
    </dim>
  </dimensions>
  <model>
    <variables>
      <aux name="r">
        <eqn>0.1</eqn>
      </aux>
      <aux name="K">
        <eqn>500</eqn>
      </aux>
      <aux name="crowding">
        <dimensions><dim name="Region"/></dimensions>
        <eqn>Population/K</eqn>
      </aux>
      <flow name="births">
        <dimensions><dim name="Region"/></dimensions>
        <eqn>r*Population*(1-crowding)</eqn>
        <non_negative/>
      </flow>
      <flow name="deaths">
        <dimensions><dim name="Region"/></dimensions>
        <eqn>0.02*Population</eqn>
        <non_negative/>
      </flow>
      <stock name="Population">
        <dimensions><dim name="Region"/></dimensions>
        <eqn>50</eqn>
        <inflow>births</inflow>
        <outflow>deaths</outflow>
        <non_negative/>
      </stock>
    </variables>
  </model>
</xmile>
